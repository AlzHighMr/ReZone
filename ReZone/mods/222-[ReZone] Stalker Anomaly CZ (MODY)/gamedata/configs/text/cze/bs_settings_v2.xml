<?xml version="1.0" encoding="windows-1250"?>
<string_table>
  <string id="ui_mcm_bs_settings_v2_audio_enabled">
    <text>Zapnout Audio2</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_audio_enabled_desc">
    <text>Doplňkové 3D zvukové náznaky událostí od ověřených entit Černého stalkera. Nezávislé na nativním zvuku Face2 i na celkové hlasitosti hry.</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_audio_intro">
    <text>Dodané zvuky dechu, šepotu, větru, látky a přesunu. Žádné krátké mluvené repliky. Zvuky pohybu vyžadují skutečný pohyb.</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_audio_volume">
    <text>Hlasitost Audio2</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_audio_volume_desc">
    <text>Ovládá jen doplňkovou atmosféru a zvukové náznaky Audio2, ne Face2, hudbu ve hře ani celkový zvuk.</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_compat_comfort">
    <text>Šetrné vizuální efekty</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_compat_comfort_desc">
    <text>Upřednostnit krátké šetrné efekty bez trvalého rozmazání</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_compat_note">
    <text>Verzi hry a kompatibilitu s G.A.M.M.A. vyber při instalaci ve FOMODu.</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_encounters_cooldown_seconds">
    <text>Interval setkání (s)</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_encounters_cooldown_seconds_desc">
    <text>Základní pauza po dokončeném setkání, vydělená četností setkání, nejméně 15 sekund. Žádný další skrytý časovač klidu.</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_encounters_frequency">
    <text>Četnost setkání</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_encounters_frequency_desc">
    <text>0,5 až 3,0. Dělí pauzu mezi dokončenými setkáními; vždy jen jeden skutečný duch. Neobchází navigaci ani běžící scénu.</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_face_cooldown_seconds">
    <text>Interval útoku tváří (s)</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_face_cooldown_seconds_desc">
    <text>Minimální pauza mezi útoky tváří (sekundy)</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_face_enabled">
    <text>Útok animovanou tváří</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_face_enabled_desc">
    <text>Útok animovanou tváří; jen když to scéna dovolí</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_face_frequency">
    <text>Šance na tvář při pozorování zblízka</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_face_frequency_desc">
    <text>Šance po způsobilém blízkém kontaktu při běžném pozorování. 1,0 = při každém způsobilém kontaktu. Hon a reaktivní scény mají vlastní spouštěče; všechny sdílejí prodlevu a bezpečnostní kontroly HUD.</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_general_enabled">
    <text>Zapnout Černého stalkera</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_general_enabled_desc">
    <text>Zapnout nebo vypnout setkání</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_general_intro">
    <text>Legenda: zdrženlivá setkání. Noční můra: intenzivnější scény, bez změny jednotlivých přepínačů.</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_general_mode">
    <text>Režim setkání</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_general_mode_desc">
    <text>Legenda je klidnější; Noční můra povolí způsobilé požadavky na tvář a zvýší váhu losování honu; jednotlivé šance zůstávají samostatné.</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_general_mode_lst_legend">
    <text>Legenda Zóny</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_general_mode_lst_nightmare">
    <text>Noční můra</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_general_reset_help">
    <text>Po obnovení klikni na Použít. Ostatní mody se nemění.</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_general_reset_recommended">
    <text>Obnovit doporučené nastavení</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_general_reset_recommended_desc">
    <text>Připraví doporučené nastavení jen pro tento mod. Uložíš ho kliknutím na Použít.</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_hunt_automatic">
    <text>Automatické hony</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_hunt_automatic_desc">
    <text>Povolit automatické hony</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_hunt_chance">
    <text>Šance na hon</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_hunt_chance_desc">
    <text>Pravděpodobnost při každém způsobilém pokusu o automatický hon. 1,0 = při každém způsobilém pokusu; vyžaduje volné místo a bezpečnou navigaci. Žádný skrytý násobič podle režimu nebo postoje.</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_psy_damage">
    <text>Psí poškození z lekaček s tváří</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_psy_damage_desc">
