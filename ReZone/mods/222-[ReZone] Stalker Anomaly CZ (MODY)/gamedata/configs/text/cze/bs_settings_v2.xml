  </string>
  <string id="ui_mcm_bs_settings_v2_reactive_close">
    <text>Blízká zjevení za zády</text>
  </string>
  <string id="ui_mcm_bs_settings_v2_reactive_close_desc">
    <text>Zjevení za zády mimo obraz upřednostňují 22–26 m; body blíž než 18 m se odmítají. Tvář vyžaduje samostatný ověřený blízký kontakt.</text>
  </string>
