![logic]
!active = sr_idle@music
active = ph_idle@music

[ph_idle@music]
on_actor_in_zone = jup_sounds_yanov_mlr | %=play_sound(jup_smart_terrain_base_radio_mlr)%
on_info2 = {=is_night} ph_idle@night
on_info3 = {=surge_started} ph_idle@surge

[ph_idle@night]
on_info = %=play_sound(jup_night_sound_mlr)%
on_info2 = {!is_night} ph_idle@music
on_info3 = {=surge_started} ph_idle@surge

[ph_idle@surge]
on_info = %=play_sound(broken_radio_mlr)%
on_info2 = {!surge_started !is_night} ph_idle@music
on_info3 = {!surge_started =is_night} ph_idle@night