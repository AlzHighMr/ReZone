[logic]
active = ph_idle@play

[ph_idle@base]
nonscript_usable = true

[ph_idle@play]:ph_idle@base
on_info = %=play_sound(monolith_red_camp_radio_speech)%
tips = Turn:Off
on_use = %=stop_sound% ph_idle@stop

[ph_idle@stop]:ph_idle@base
tips = Turn:On
on_use = ph_idle@play

[ph_idle@reset]
tips = Turn:On
on_use = ph_idle@play
on_game_timer = 15500 | ph_idle@play

[collide]
ignore_static