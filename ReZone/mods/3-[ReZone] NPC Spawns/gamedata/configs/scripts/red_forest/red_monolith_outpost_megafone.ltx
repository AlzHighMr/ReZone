[logic]
active = {+monolith_red_outpost_megafone} ph_idle@play, ph_idle@stop %=stop_sound%

[ph_idle@play]
nonscript_usable = false
on_info = {+monolith_red_outpost_megafone} %=play_sound(monolith_red_outpost_speech)%

[ph_idle@stop]
nonscript_usable = false
on_info = {+monolith_red_outpost_megafone} ph_idle@play

[collide]
ignore_static





