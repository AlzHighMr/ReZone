local KIT = {
	bar_arena_fight_1 = { "novice_outfit", "helm_hardhat", "wpn_pm", "ammo_9x18_pmm", "ammo_9x18_pmm", "wpn_knife", "bandage", "bandage", "medkit" },
	bar_arena_fight_2 = { "stalker_outfit", "helm_hardhat", "wpn_mp5", "ammo_9x19_fmj", "ammo_9x19_fmj", "ammo_9x19_fmj", "wpn_knife", "bandage", "bandage", "medkit" },
	bar_arena_fight_3 = { "stalker_tigerstripe_outfit", "helm_hardhat", "wpn_bm16", "ammo_12x70_buck", "ammo_12x70_buck", "wpn_knife", "bandage", "bandage", "medkit" },
	bar_arena_fight_4 = { "trenchcoat_brown_outfit", "helm_hardhat", "wpn_ak74_old", "ammo_5.45x39_ap", "ammo_5.45x39_ap", "wpn_knife", "bandage", "bandage", "medkit" },
	bar_arena_fight_5 = { "wpn_desert_eagle_gold", "ammo_357_hp_mag", "ammo_357_hp_mag", "ammo_357_hp_mag", "wpn_knife", "bandage", "bandage", "medkit", "helm_hardhat", "svoboda_light_outfit" },
	bar_arena_fight_6 = { "wpn_p90", "ammo_5.7x28_ss190", "ammo_5.7x28_ss190", "ammo_5.7x28_ss190", "bandage", "bandage", "medkit", "grenade_voronka", "wpn_knife", "helm_hardhat", "specops_outfit" },
	bar_arena_fight_7 = { "wpn_axe2", "bandage", "rebirth", "grenade_web", "specops_outfit", "helm_hardhat" },
	bar_arena_fight_8 = { "wpn_m4", "exo_wood_outfit", "helm_exo", "ammo_5.56x45_ap", "ammo_5.56x45_ap", "ammo_5.56x45_ap", "ammo_5.56x45_ap", "bandage", "bandage", "rebirth", "wpn_knife" },
}
local ORDER = { "bar_arena_fight_1", "bar_arena_fight_2", "bar_arena_fight_3", "bar_arena_fight_4",
                "bar_arena_fight_5", "bar_arena_fight_6", "bar_arena_fight_7", "bar_arena_fight_8" }

local function kit_now()
	for _, info in ipairs(ORDER) do
		if has_alife_info(info) then return KIT[info] end
	end
end

local function teleport(actor, npc)
	actor_effects.disable_effects_timer(100)
	hide_hud_all()
	local box = get_story_object("bar_arena_inventory_box")
	if box then
		db.actor:inventory_for_each(function(item) db.actor:transfer_item(item, box) end)
	end
	for _, sec in ipairs(kit_now() or {}) do
		if ini_sys:section_exist(sec) then
			local se = alife_create(sec, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), AC_ID)
			if se then se_save_var(se.id, se:name(), "unpatched", true) end
		else
			rezone_core.dbg("! ReZone arena: predmet %s neexistuje", sec)
		end
	end
end

function on_game_start()
	if xr_effects and xr_effects.bar_arena_teleport then
		xr_effects.bar_arena_teleport = teleport
	end
end
