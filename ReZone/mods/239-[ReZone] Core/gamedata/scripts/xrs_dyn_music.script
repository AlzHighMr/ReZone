TRACK_SWITCH_DELTA = 3000
MAX_DIST = 100
MIN_DIST = 75
THEME_FADE_UPDATE_DELTA = 100
AMBIENT_FADE_UPDATE_DELTA = 100
LOOP_DELTA = 100
VOLUME_DELTA = 0

npc_table = {}

ambient_vol = get_console_cmd(2,"snd_volume_music")
m_ambient_vol = 0
FadeTo_ambient = 0
m_theme_volume = 0
FadeTo_theme = 0

cur_theme_number = 0
cur_track_number = 0
next_track_start_time = 0
theme = nil

local init_failed = false
local themes_inited = false
local prev_theme_fade = 0
local prev_ambient_fade = 0
local force_fade = false
local was_in_silence = false
local vol_changed = false
local _tmr

local combat_themes ={
	{
		"music\\combat\\theme1_part_1",
		"music\\combat\\theme1_part_2",
		"music\\combat\\theme1_part_3"
	},
	{
		"music\\combat\\theme2_part_1",
		"music\\combat\\theme2_part_2",
		"music\\combat\\theme2_part_3"
	},
	{
		"music\\combat\\theme3_part_1",
		"music\\combat\\theme3_part_2",
		"music\\combat\\theme3_part_3"
	},
	{
		"music\\combat\\theme4_part_1",
		"music\\combat\\theme4_part_2",
		"music\\combat\\theme4_part_3"
	}
}

local function set_music_vol(v)
	vol_changed = math.abs(v - ambient_vol) > 0.0001
	exec_console_cmd("snd_volume_music "..v)
end

local function restore_music_vol()
	if vol_changed then
		exec_console_cmd("snd_volume_music "..ambient_vol)
		vol_changed = false
	end
end

local function vol_delta()
	VOLUME_DELTA = math.max(ambient_vol/50, 0.001)
	return VOLUME_DELTA
end

feature_is_active = nil
local function main_loop()
	local tg = time_global()
	if (_tmr and tg < _tmr) then
		return false
	end
	_tmr = tg + LOOP_DELTA

	if not (db.actor) then
		return false
	end

	if (init_failed) then
		return true
	end

	local surge = surge_manager.sound_started()
	if (surge) then
		if (surge_manager.is_killing_all()) then
			force_fade = true
			FadeTo_ambient = ambient_vol
			fade_ambient()
			force_fade = false
		else
			FadeTo_ambient = 0
			fade_ambient()
		end
	end

	if not (themes_inited) then
		initialize_themes()
	end

	if (theme) then
		theme:update(m_theme_volume)
	end

	local state = get_theme_state()
	if (state=="start") then
		start_theme()
	elseif (state=="idle") then
		if (theme_is_fading()) then
			fade_theme()
		elseif (ambient_is_fading()) then
			fade_ambient()
		end
		if (theme and time_global()>next_track_start_time) then
			select_next_track()
		end
	elseif (state=="finish") then
		finish_theme()
	elseif (not surge) then
		FadeTo_ambient = ambient_vol
		if (ambient_is_fading()) then
			fade_ambient()
		end
	end

	return false
end

function activate_feature()
	if (feature_is_active) then
		return
	end
	feature_is_active = true
	AddUniqueCall(main_loop)
	RegisterScriptCallback("actor_on_net_destroy",on_actor_destroy)
	RegisterScriptCallback("on_before_level_changing",on_actor_destroy)
end

function deactivate_feature()
	if not (feature_is_active) then
		return
	end
	feature_is_active = false
	RemoveUniqueCall(main_loop)
	UnregisterScriptCallback("actor_on_net_destroy",on_actor_destroy)
	UnregisterScriptCallback("on_before_level_changing",on_actor_destroy)
	finish_theme()
	restore_music_vol()
end

function on_game_start()
	if (IsDynamicMusic()) then
		activate_feature()
	end
end

function initialize_themes()
	m_ambient_vol = ambient_vol
	m_theme_volume = ambient_vol
	FadeTo_theme = ambient_vol
	FadeTo_ambient = ambient_vol

	cur_theme_number = 0
	cur_track_number = 0
	next_track_start_time = 0
	theme = nil

	vol_delta()
	set_music_vol(ambient_vol)

	themes_inited = true
end

function on_actor_destroy()
	if (theme) and (theme:playing()) then
		theme:stop()
	end
	exec_console_cmd("snd_volume_music "..ambient_vol)
	vol_changed = false
	themes_inited = false
end

function main_menu_on()
	exec_console_cmd("snd_volume_music "..ambient_vol)
end

function main_menu_off()
	ambient_vol = get_console_cmd(2,"snd_volume_music")
	vol_delta()

	if (IsDynamicMusic()) then
		activate_feature()
		set_music_vol(themes_inited and clamp(m_ambient_vol, 0, ambient_vol) or ambient_vol)
	else
		deactivate_feature()
	end
end

local function has_enemy(actor)
	local apos = actor:position()
	local d = theme and MAX_DIST or MIN_DIST
	d = d * d
	for id,v in pairs(xr_combat_ignore.fighting_with_actor_npcs) do
		local npc = db.storage[id] and db.storage[id].object
		if (npc and IsStalker(npc) and npc:alive() and npc:position():distance_to_sqr(apos) <= d) then
			return true
		end
	end
	return false
end

function get_theme_state()
	local actor = db.actor
	force_fade = false

	if not (actor:alive()) then
		if(theme) then
			FadeTo_theme = 0
			FadeTo_ambient = ambient_vol
			if(theme_is_fading() or ambient_is_fading()) then
				return "idle"
			else
				set_music_vol(ambient_vol)
				return "finish"
			end
		end
		return nil
	end

	if (actor_in_silence_zone()) then
		if(theme) then
			was_in_silence = true
			FadeTo_theme = 0
			FadeTo_ambient = 0
			return "idle"
		end
		return nil
	end

	if(was_in_silence) then
		was_in_silence = false
		FadeTo_ambient = ambient_vol
	end

	if not (has_enemy(actor)) then
		if(theme) then
			FadeTo_theme = 0
			FadeTo_ambient = ambient_vol
			if(theme_is_fading() or ambient_is_fading()) then
				return "idle"
			else
				set_music_vol(ambient_vol)
				return "finish"
			end
		end
		return nil
	end

	force_fade = true
	FadeTo_theme = ambient_vol
	FadeTo_ambient = 0
	if(theme) then
		return "idle"
	else
		return "start"
	end
end

function theme_is_fading()
	return m_theme_volume~=FadeTo_theme
end

function ambient_is_fading()
	return m_ambient_vol~=FadeTo_ambient
end

function actor_in_silence_zone()
	local silence_zones = db.storage.silence_zone_table
	if (silence_zones) then
		local actor_pos = db.actor:position()
		for k,v in pairs(silence_zones) do
			local zone = db.zone_by_name[v]
			if(zone and zone:inside(actor_pos)) then
				return true
			end
		end
	end

	if (utils_obj.npc_in_zone(db.actor, "zat_a2_sr_no_assault")) then
		return true
	end

	if (utils_obj.npc_in_zone(db.actor, "jup_a6_sr_no_assault")) then
		return true
	end

	if (utils_obj.npc_in_zone(db.actor, "jup_b41_sr_no_assault")) then
		return true
	end

	return false
end

function start_theme()
	cur_theme_number = math.random(1, #combat_themes)
	cur_track_number = math.random(1, #combat_themes[cur_theme_number])
	if(theme==nil) then
		theme = this.stereo_sound()
	end
	m_theme_volume = ambient_vol
	if not theme:initialize(combat_themes[cur_theme_number][cur_track_number], m_theme_volume) then
		theme = nil
		init_failed = true
		return
	end
	local t = theme:play()
	if not t then
		theme = nil
		return
	end
	m_ambient_vol = 0
	set_music_vol(m_ambient_vol)
	next_track_start_time = t - TRACK_SWITCH_DELTA
	theme:update(m_theme_volume)
end

function fade_theme()
	local g_time = time_global()
	if (g_time-prev_theme_fade<THEME_FADE_UPDATE_DELTA) then
		return
	end
	prev_theme_fade = g_time

	FadeTo_theme = clamp(FadeTo_theme, 0, ambient_vol)
	local dv = vol_delta()

	if (m_theme_volume>FadeTo_theme) then
		if (force_fade) then
			m_theme_volume = FadeTo_theme
		else
			m_theme_volume = m_theme_volume - dv
		end
		m_theme_volume = clamp(m_theme_volume, FadeTo_theme, m_theme_volume)
	elseif (m_theme_volume<FadeTo_theme) then
		if (force_fade) then
			m_theme_volume = FadeTo_theme
		else
			m_theme_volume = m_theme_volume + dv
		end
		m_theme_volume = clamp(m_theme_volume, m_theme_volume, FadeTo_theme)
	end
end

function fade_ambient()
	local g_time = time_global()
	if (g_time-prev_ambient_fade<AMBIENT_FADE_UPDATE_DELTA) then
		return
	end
	prev_ambient_fade = g_time

	FadeTo_ambient = clamp(FadeTo_ambient, 0, ambient_vol)
	m_ambient_vol = clamp(m_ambient_vol, 0, ambient_vol)
	local dv = vol_delta()

	if (m_ambient_vol>FadeTo_ambient) then
		if (force_fade) then
			m_ambient_vol = FadeTo_ambient
		else
			m_ambient_vol = m_ambient_vol - dv
		end
		m_ambient_vol = clamp(m_ambient_vol, FadeTo_ambient, m_ambient_vol)
	elseif (m_ambient_vol<FadeTo_ambient) then
		if (force_fade) then
			m_ambient_vol = FadeTo_ambient
		else
			m_ambient_vol = m_ambient_vol + dv
		end
		m_ambient_vol = clamp(m_ambient_vol, m_ambient_vol, FadeTo_ambient)
	end
	set_music_vol(m_ambient_vol)
end

function select_next_track()
	local list = combat_themes[cur_theme_number]
	if not (list and theme) then
		finish_theme()
		return
	end
	if (cur_track_number<#list) then
		cur_track_number = cur_track_number + 1
	else
		cur_track_number = 1
	end
	local t = theme:play_at_time(next_track_start_time + TRACK_SWITCH_DELTA,list[cur_track_number],m_theme_volume)
	if t then
		next_track_start_time = t - TRACK_SWITCH_DELTA
	else
		next_track_start_time = time_global() + 60000
	end
end

function finish_theme()
	if (theme) and (theme:playing()) then
		theme:stop()
	end
	theme = nil
	themes_inited = false
end

class "stereo_sound"
function stereo_sound:__init()
	self.both = nil
	self.end_time=nil
end

function stereo_sound:initialize(sound,lvl)
	if self.both then self:stop() end
	self.both = sound_object(sound)
	self.end_time = nil
	if not self.both then
		return false
	end
	if lvl then
		self:set_volume(lvl)
	end
	return true
end

function stereo_sound:play()
	if not (db.actor and self.both) then
		return
	end
	self.both:play(db.actor,0, sound_object.s2d)
	self.end_time = time_global() + self.both:length()
	return self.end_time
end

function stereo_sound:play_at_time(time, sound, lvl)
	if not self.both then
		return
	end
	self.end_time = nil
	self.both:attach_tail(sound)
	if lvl then
		self:set_volume(lvl)
	end
	self.both_tail = sound_object(sound)
	if not self.both_tail then
		return
	end
	self.end_time = time + self.both_tail:length()
	return self.end_time
end

function stereo_sound:playing()
	return self.both and self.both:playing()
end

function stereo_sound:update(vol)
	if vol and self:playing() then self:set_volume(vol)end
end

function stereo_sound:stop()
	if self.both and self.both:playing() then self.both:stop() end
end

function stereo_sound:length()
	return self.both and self.both:length() or 1
end

function stereo_sound:set_volume(num)
	if self.both then self.both.volume=num end
end
