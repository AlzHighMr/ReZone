local ROOT = "rezone/"
MASTER = ROOT .. "rz_main/rz_master/master"
LINK = ROOT .. "rz_main/rz_master/link"
local APPLIED = "rz_master_applied"

NAMES = { [0] = "custom", [1] = "cop", [2] = "trilogy", [3] = "hardcore" }

local function copy_into(set, prefix, t)
	for k, v in pairs(t) do set[prefix .. k] = v end
end

local MAP = {

	[1] = { classic = true, ball = 0, pdmg = 1, loot = 2, pop = 2, efth = 5 },

	[2] = { ball = 1, pdmg = 3, loot = 2, pop = 1, efth = 2, afsp = 3, tough = 1.0, wear = 0.5,
	        prices = 1, prices_on = false, stock = false, mut = 1.0, punish = 1.0, walk = 0, keep_known = false },

	[3] = { ball = 2, pdmg = 4, loot = 3, pop = 4, efth = 4, afsp = 4, tough = 1.2, wear = 1.0,
	        prices = 6, prices_on = true, stock = true, mut = 1.3, punish = 1.5, walk = 0, keep_known = false },
}

local function build(id)
	local m = MAP[id]
	if not m then return {} end
	local s = {}
	if m.classic then
		s["rz_combat/rz_ball/enabled"] = true
		s["rz_combat/rz_ball/preset"] = m.ball
		s["rz_combat/rz_ball/st_all"] = 1
		s["rz_combat/rz_pdmg/enabled"] = true
		s["rz_combat/rz_pdmg/preset"] = m.pdmg
		copy_into(s, "rz_combat/rz_pdmg/", rezone_presets.PRESETS[m.pdmg])
		s["rz_econ/rz_loot/enabled"] = true
		s["rz_econ/rz_loot/preset"] = m.loot
		copy_into(s, "rz_econ/rz_loot/", rezone_loot_presets.PRESETS[m.loot])
		if rezone_mod_population then
			s["rz_world/rz_pop/enabled"] = true
			s["rz_world/rz_pop/preset"] = m.pop
			copy_into(s, "rz_world/rz_pop/", rezone_mod_population.PRESETS[m.pop])
		end
		s["rz_combat/rz_ball/wear"] = 0.9
		s["rz_combat/rz_ball/helmets"] = false
		s["rz_combat/rz_ball/helm_drop"] = false
		s["rz_combat/rz_ball/head_kill"] = true
		s["rz_combat/rz_vision/mutant"] = 0.15
		s["rz_combat/rz_vision/st_danger"] = 0.5
		s["rz_combat/rz_vision/st_free"] = 0.5
		s["rz_econ/rz_craft/keep_known"] = true
		if rezone_mod_afspawn then
			s["rz_world/rz_afsp/enabled"] = true
			s["rz_world/rz_afsp/preset"] = 2
			copy_into(s, "rz_world/rz_afsp/", rezone_mod_afspawn.PRESETS[2])
		end
		s["!efth/efth_gen/difficulty"] = m.efth
		return s
	end
	s["rz_combat/rz_ball/enabled"] = true
	s["rz_combat/rz_ball/preset"] = m.ball
	s["rz_combat/rz_ball/st_all"] = m.tough
	if math.abs(m.tough - 1) > 0.001 then s["rz_combat/rz_ball/st_enabled"] = true end
	s["rz_combat/rz_ball/wear"] = m.wear

	s["rz_econ/rz_prices/enabled"] = m.prices_on
	s["rz_econ/rz_prices/preset"] = m.prices
	if rezone_prices and rezone_prices.PRESETS[m.prices] then
		copy_into(s, "rz_econ/rz_prices/", rezone_prices.PRESETS[m.prices])
	end
	s["rz_econ/rz_trade/enabled"] = true
	s["rz_econ/rz_trade/stock"] = m.stock

	s["rz_econ/rz_trade/helm_no_sell"] = false
	s["rz_econ/rz_trade/helm_no_buy"] = false

	s["rz_combat/rz_muthp/enabled"] = math.abs(m.mut - 1) > 0.001
	s["rz_combat/rz_muthp/all"] = m.mut
	s["rz_survival/rz_af/punish_chance"] = m.punish
	s["rz_survival/rz_af/punish_strength"] = m.punish

	if rezone_mod_wander then
		s["rz_world/rz_walk/enabled"] = m.walk > 0
		if m.walk > 0 then s["rz_world/rz_walk/max_squads"] = m.walk end
	end

	s["rz_econ/rz_craft/keep_known"] = m.keep_known
	s["rz_combat/rz_pdmg/enabled"] = true
	s["rz_combat/rz_pdmg/preset"] = m.pdmg
	copy_into(s, "rz_combat/rz_pdmg/", rezone_presets.PRESETS[m.pdmg])
	s["rz_econ/rz_loot/enabled"] = true
	s["rz_econ/rz_loot/preset"] = m.loot
	copy_into(s, "rz_econ/rz_loot/", rezone_loot_presets.PRESETS[m.loot])
	if rezone_mod_population then
		s["rz_world/rz_pop/enabled"] = true
		s["rz_world/rz_pop/preset"] = m.pop
		copy_into(s, "rz_world/rz_pop/", rezone_mod_population.PRESETS[m.pop])
	end
	if rezone_mod_afspawn then
		s["rz_world/rz_afsp/enabled"] = true
		s["rz_world/rz_afsp/preset"] = m.afsp
		copy_into(s, "rz_world/rz_afsp/", rezone_mod_afspawn.PRESETS[m.afsp])
	end
	s["!efth/efth_gen/difficulty"] = m.efth
	return s
end

local function log(fmt, ...) if rezone_core then rezone_core.dbg("[ReZone predvolba] " .. fmt, ...) end end

local function applied_get()
	local c = axr_main and axr_main.config
	return c and tonumber(c:r_value("rezone_internal", APPLIED, 2, 0)) or 0
end

local function applied_set(id)
	local c = axr_main and axr_main.config
	if not c then return end
	c:w_value("rezone_internal", APPLIED, id)
	c:save()
end

function apply(id)
	local set = build(id)
	local n = 0
	for k, v in pairs(set) do
		local path = (k:sub(1, 1) == "!") and k:sub(2) or (ROOT .. k)
		local okh, has = pcall(rezone_core.mcm_has, path)
		if okh and has and pcall(ui_mcm.set, path, v) then n = n + 1 end
	end
	log("%s: nastaveno %d voleb", NAMES[id] or tostring(id), n)
	return n
end

local function is_eco(k)
	return k:find("^rz_econ/") ~= nil or k:find("^rz_world/rz_afsp/") ~= nil or k == "rz_combat/rz_ball/wear"
end

function apply_split(game_id, eco_id)
	local set = {}
	for k, v in pairs(build(game_id)) do
		if not is_eco(k) then set[k] = v end
	end
	for k, v in pairs(build(eco_id)) do
		if is_eco(k) then set[k] = v end
	end
	local n = 0
	for k, v in pairs(set) do
		local path = (k:sub(1, 1) == "!") and k:sub(2) or (ROOT .. k)
		local okh, has = pcall(rezone_core.mcm_has, path)
		if okh and has and pcall(ui_mcm.set, path, v) then n = n + 1 end
	end
	log("obtiznost %s, progrese %s: nastaveno %d voleb", NAMES[game_id] or tostring(game_id), NAMES[eco_id] or tostring(eco_id), n)
	return n
end

function on_select(path, opt, value, v)
	local id = tonumber(value) or 0
	if id == 0 then return end
	local gui = ui_mcm and ui_mcm.get_gui and ui_mcm.get_gui()
	if not (gui and gui.CacheValue and gui.GetOption) then return end
	local n = 0
	for k, val in pairs(build(id)) do
		local full = (k:sub(1, 1) == "!") and k:sub(2) or (ROOT .. k)
		if rezone_core.mcm_has(full) then
			local p, o = full:match("^(.*)/([^/]+)$")
			local ov = p and gui:GetOption(full)
			if ov and ov.type then
				local ok = pcall(gui.CacheValue, gui, p, o, val, ov)
				if ok then n = n + 1 end
			end
		end
	end
	if rezone_core.DEBUG then log("%s: oznaceno %d voleb", NAMES[id] or tostring(id), n) end
end

local busy = false
local function on_option_change()
	if busy or not (ui_mcm and ui_mcm.get and rezone_core.mcm_has(MASTER)) then return end
	local id = tonumber(ui_mcm.get(MASTER)) or 0
	if id == applied_get() then return end
	applied_set(id)
	if id == 0 then return end
	apply(id)

	busy = true
	pcall(SendScriptCallback, "on_option_change", true)
	busy = false
end

function hook_gui()
	local C = ui_mcm and ui_mcm.UI_MCM
	if not (C and C.CacheValue) or C.__rz_master_hook then return end
	local orig = C.CacheValue
	C.__rz_master_hook = true
	C.CacheValue = function(self, path, opt, value, v)
		orig(self, path, opt, value, v)
		if path and opt and (path .. "/" .. opt) == MASTER then
			local id = tonumber(value) or 0
			if id == 0 then return end
			local n = 0
			for k, val in pairs(build(id)) do
				local full = (k:sub(1, 1) == "!") and k:sub(2) or (ROOT .. k)
				local p, o = full:match("^(.*)/([^/]+)$")
				local okh, has = pcall(rezone_core.mcm_has, full)
				if p and okh and has then
					local okg, ov = pcall(self.GetOption, self, full)
					if okg and type(ov) == "table" and ov.type and pcall(orig, self, p, o, val, ov) then n = n + 1 end
				end
			end
			log("%s: oznaceno %d voleb", NAMES[id] or tostring(id), n)
		end
	end
end

local function diff_type(t)
	local n = t and tonumber(t.type)
	if not n then return nil end
	return math.max(1, math.min(3, math.floor(n)))
end

local function link_new_game()
	local st = alife_storage_manager and alife_storage_manager.get_state()
	if not st or st.rz_diff_link ~= nil then return end
	if has_alife_info("start_equippment_handled") or not (ui_mcm and ui_mcm.get and ui_mcm.set) then
		st.rz_diff_link = false
		return
	end
	if rezone_core.get(LINK) == false then
		st.rz_diff_link = false
		return
	end
	local g, e = diff_type(st.diff_game), diff_type(st.diff_eco)
	if not (g and e) then
		st.rz_diff_link = false
		return
	end
	local id = (g == e) and g or 0
	busy = true
	pcall(ui_mcm.set, MASTER, id)
	applied_set(id)
	apply_split(g, e)
	st.rz_diff_link = { g, e }
	pcall(SendScriptCallback, "on_option_change", true)
	busy = false
end

local function on_first_update()
	pcall(link_new_game)
	busy = false
	on_option_change()
end

function on_game_start()
	hook_gui()
	RegisterScriptCallback("on_option_change", on_option_change)

	RegisterScriptCallback("actor_on_first_update", on_first_update)
end
