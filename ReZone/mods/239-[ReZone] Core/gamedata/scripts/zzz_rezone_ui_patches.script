local core = rezone_core
local PAGE = rezone_mcm.path("rz_hud")

local opt = { msv = true }
local MSV = 10000 * 0.387
local CLR = { 255, 235, 235, 235 }

local function has_geiger()
	return db.actor and db.actor:object("detector_geiger") ~= nil
end

local function rad_shown()
	local v = actor_status.get_radiation and actor_status.get_radiation(true)
	return v and v >= 1 and v <= 4
end

local function own_text(ui)
	if ui.rz_msv then return ui.rz_msv end
	local s = ui.slot and ui.slot[1]
	local ico = s and (s.icon_f or s.icon_s)
	if not (ico and ui.dialog) then return nil end
	local p = ico:GetWndPos()
	local w, h = ico:GetWidth(), ico:GetHeight()
	local t = CUITextWnd()
	t:SetAutoDelete(true)
	ui.dialog:AttachChild(t)
	t:SetWndRect(Frect():set(p.x - 10, p.y + h, p.x + w + 10, p.y + h + 16))
	t:SetFont(GetFontSmall())
	t:SetTextAlignment(2)
	t:SetTextColor(GetARGB(CLR[1], CLR[2], CLR[3], CLR[4]))
	t:Show(false)
	ui.rz_msv = t
	return t
end

local function msv_refresh(ui)
	local s = ui.slot and ui.slot[1]
	local t = s and s.xcvb_time or own_text(ui)
	if not t then return end
	local show = opt.msv and db.actor and main_hud_shown() and rad_shown() and has_geiger()
	if show then
		t:SetText(tostring(math.floor(db.actor.radiation * MSV)))
		t:Show(true)
	elseif t == ui.rz_msv then
		t:Show(false)
	end
end

local patched = false
local function patch()
	if patched or not (actor_status and actor_status.UIIndicators) then return end
	patched = true
	local cls = actor_status.UIIndicators
	local orig = cls.Update
	cls.Update = function(self, force)
		local before = self._tmr
		orig(self, force)
		if force or self._tmr ~= before then
			local ok, err = pcall(msv_refresh, self)
			if not ok then core.warn("ui: msv %s", tostring(err)) end
		end
	end
end

local TPAGE = rezone_mcm.path("rz_taskhud")
local topt = { on = true, y = 60, time = 7, rows = 3, fade = true, fade_y = 625, news = true }
local T_ICON = { new = "ui_rz_task_new", updated = "ui_rz_task_new", complete = "ui_rz_task_done", fail = "ui_rz_task_done", reversed = "ui_rz_task_done" }
local T_CLR = { new = { 255, 255, 255 }, updated = { 255, 255, 255 }, complete = { 255, 255, 255 }, fail = { 235, 120, 110 }, reversed = { 190, 190, 190 } }
local T_HEAD = { complete = "st_rz_task_complete", fail = "st_rz_task_fail", reversed = "st_rz_task_reversed" }
local T_SUB = { new = "st_rz_task_new", updated = "st_rz_task_updated" }
local FADE_IN, FADE_OUT = 250, 600
local ROW_H, ICON, GAP, MAXW, SUBW = 44, 26, 10, 520, 560

local function clean(str)
	str = tostring(str or "")
	str = str:gsub("%%c%[[^%]]*%]", ""):gsub("\\n", " "):gsub("[\r\n]+", " "):gsub("%s+", " ")
	return str:gsub("^%s+", ""):gsub("%s+$", "")
end

local function tr(id)
	return id and clean(game.translate_string(id)) or ""
end

class "UIRzTaskHud" (CUIScriptWnd)

function UIRzTaskHud:__init() super()
	self:SetWndRect(Frect():set(0, 0, 1024, 768))
	self:SetAutoDelete(true)
	self.rows = {}
	self.queue = {}
	self.last = time_global()
end

function UIRzTaskHud:make_row()
	local r = {}
	r.bg = CUIStatic()
	r.bg:SetAutoDelete(true)
	self:AttachChild(r.bg)
	r.bg:InitTexture("ui_rz_task_bg")
	r.bg:SetStretchTexture(true)
	r.icon = CUIStatic()
	r.icon:SetAutoDelete(true)
	self:AttachChild(r.icon)
	r.icon:InitTexture("ui_rz_task_new")
	r.icon:SetStretchTexture(true)
	r.title = CUITextWnd()
	r.title:SetAutoDelete(true)
	self:AttachChild(r.title)
	r.title:SetFont(GetFontGraffiti19Russian())
	r.title:SetTextAlignment(0)
	r.sub = CUITextWnd()
	r.sub:SetAutoDelete(true)
	self:AttachChild(r.sub)
	r.sub:SetFont(GetFontLetterica16Russian())
	r.sub:SetTextAlignment(0)
	return r
end

local function text_w(wnd, txt, per, max)
	max = max or MAXW
	wnd:SetWndSize(vector2():set(max, 20))
	wnd:SetText(txt)
	local w
	pcall(function()
		wnd:AdjustWidthToText()
		w = wnd:GetWidth()
	end)
	if not w or w <= 1 or w > 2000 then w = string.len(txt) * per end
	return math.min(max, w)
end

local function sub_size(wnd, txt)
	wnd:SetTextComplexMode(false)
	local w = text_w(wnd, txt, 7, 4000)
	if w <= SUBW then return w, 16 end
	wnd:SetTextComplexMode(true)
	wnd:SetWndSize(vector2():set(SUBW, 16))
	wnd:SetText(txt)
	local h = 32
	pcall(function()
		wnd:AdjustHeightToText()
		h = wnd:GetHeight()
	end)
	if not h or h < 16 then h = 32 end
	return SUBW, math.min(h, 64)
end

function UIRzTaskHud:layout(r, e)
	local k = utils_xml.screen_ratio()
	local iw = ICON * k
	local tw = text_w(r.title, e.title, 9.5)
	local sw, sh = 0, 0
	if e.sub ~= "" then sw, sh = sub_size(r.sub, e.sub) end
	e.h = ROW_H + math.max(0, sh - 16)
	local bw = iw + GAP * k + math.max(tw, sw)
	e.x0 = 512 - bw / 2
	e.bw = bw
	e.tw, e.sw, e.iw = tw, sw, iw
end

function UIRzTaskHud:place(r, e, y)
	local pad = 40 * utils_xml.screen_ratio()
	r.bg:SetWndRect(Frect():set(e.x0 - pad, y - 4, e.x0 + e.bw + pad, y + e.h - 2))
	local iy = y + (e.sub ~= "" and 8 or 4)
	r.icon:InitTexture(e.icon)
	r.icon:SetStretchTexture(true)
	r.icon:SetWndRect(Frect():set(e.x0, iy, e.x0 + e.iw, iy + ICON))
	local tx = e.x0 + e.iw + GAP * utils_xml.screen_ratio()
	r.title:SetWndRect(Frect():set(tx, y + 3, tx + e.tw + 4, y + 23))
	r.title:SetText(e.title)
	r.sub:SetWndRect(Frect():set(tx, y + 23, tx + e.sw + 4, y + e.h - 5))
	r.sub:SetText(e.sub)
end

function UIRzTaskHud:paint(r, e, a)
	local c = e.clr
	local A = math.floor(255 * a)
	r.bg:SetTextureColor(GetARGB(math.floor(200 * a), 255, 255, 255))
	r.icon:SetTextureColor(GetARGB(A, c[1], c[2], c[3]))
	r.title:SetTextColor(GetARGB(A, c[1], c[2], c[3]))
	r.sub:SetTextColor(GetARGB(math.floor(200 * a), 200, 200, 200))
end

function UIRzTaskHud:push(e)
	e.t = 0
	e.life = topt.time * 1000
	table.insert(self.queue, 1, e)
	while #self.queue > topt.rows do table.remove(self.queue) end
	self.dirty = true
end

local function static_text(hud, id)
	local st = hud:GetCustomStatic(id)
	if not st then return nil end
	local txt
	pcall(function() txt = st:wnd():TextControl():GetText() end)
	return clean(txt)
end

function UIRzTaskHud:grab_active()
	local hud = get_hud()
	if not (hud and hud:GetCustomStatic("main_task")) then return end
	local title = static_text(hud, "main_task") or ""
	local sub = static_text(hud, "secondary_task") or ""
	hud:RemoveCustomStatic("main_task")
	if hud:GetCustomStatic("secondary_task") then hud:RemoveCustomStatic("secondary_task") end
	if title == "" then return end
	local top = self.queue[1]
	if top and top.active and top.title == title and top.sub == sub then
		top.t = math.min(top.t, FADE_IN)
		return
	end
	self:push({ active = true, title = title, sub = sub, icon = sub ~= "" and "ui_rz_task_new" or "ui_rz_task_done", clr = T_CLR.new })
end

function UIRzTaskHud:Update()
	CUIScriptWnd.Update(self)
	if topt.on then pcall(self.grab_active, self) end
	local now = time_global()
	local dt = math.min(200, now - self.last)
	self.last = now
	local show = #self.queue > 0 and main_hud_shown()
	if not show then
		for _, r in ipairs(self.rows) do
			r.bg:Show(false) r.icon:Show(false) r.title:Show(false) r.sub:Show(false)
		end
		return
	end
	local keep = {}
	for _, e in ipairs(self.queue) do
		e.t = e.t + dt
		if e.t < e.life + FADE_OUT then keep[#keep + 1] = e else self.dirty = true end
	end
	self.queue = keep
	while #self.rows < #self.queue do self.rows[#self.rows + 1] = self:make_row() end
	local y = topt.y
	for i, r in ipairs(self.rows) do
		local e = self.queue[i]
		if e then
			if self.dirty or r.e ~= e then
				r.e = e
				self:layout(r, e)
				self:place(r, e, y)
			end
			y = y + (e.h or ROW_H)
			local a = 1
			if e.t < FADE_IN then a = e.t / FADE_IN
			elseif e.t > e.life then a = 1 - (e.t - e.life) / FADE_OUT end
			a = math.max(0, math.min(1, a))
			self:paint(r, e, a)
			r.bg:Show(true) r.icon:Show(true) r.title:Show(true) r.sub:Show(e.sub ~= "")
		else
			r.e = nil
			r.bg:Show(false) r.icon:Show(false) r.title:Show(false) r.sub:Show(false)
		end
	end
	self.dirty = false
end

local THUD = nil
local function task_hud()
	if not THUD then
		THUD = UIRzTaskHud()
		get_hud():AddDialogToRender(THUD)
	end
	return THUD
end

local function task_descr(tsk)
	local d = ""
	pcall(function()
		local tm = task_manager.get_task_manager()
		local o = tm and tm.task_info and tm.task_info[tsk:get_id()]
		local s = o and o.current_descr
		if type(s) == "string" and s ~= "" then d = tr(s) end
	end)
	if d == "" then pcall(function() d = tr(tsk:get_description()) end) end
	return d
end

local function task_entry(typ, tsk)
	local title = tr(tsk:get_title())
	local desc = task_descr(tsk)
	local e = { icon = T_ICON[typ] or "ui_rz_task_new", clr = T_CLR[typ] or T_CLR.new }
	if T_HEAD[typ] then
		e.title, e.sub = tr(T_HEAD[typ]), title
	else
		e.title = title
		e.sub = (desc ~= "" and desc ~= title) and desc or tr(T_SUB[typ] or "st_rz_task_new")
	end
	return e
end

local orig_send_task = nil
local function send_task(actor, typ, tsk)
	if not (topt.on and db.actor and tsk) then
		return orig_send_task(actor, typ, tsk)
	end
	local ok, err = pcall(function()
		task_hud():push(task_entry(typ, tsk))
	end)
	if not ok then
		core.warn("ui: ukol %s", tostring(err))
		return orig_send_task(actor, typ, tsk)
	end
	if db.actor:is_talking() then
		return orig_send_task(actor, typ, tsk)
	end
	xr_sound.set_sound_play(AC_ID, "pda_task")
	return true
end

local orig_fade_msg = nil
local function fade_msg(msg, tm, cl, snd)
	if topt.on and type(msg) == "string" then
		local pre = game.translate_string("general_new_task")
		if pre and pre ~= "" and msg:sub(1, #pre) == pre then return end
	end
	return orig_fade_msg(msg, tm, cl, snd)
end

local FADE_ID = "not_enough_money_mine"
local FADE_W = 800
local fade_pos = nil
local function place_fade()
	local hud = get_hud()
	local cs = hud and hud:GetCustomStatic(FADE_ID)
	local w = cs and cs:wnd()
	if not w then return end
	fade_pos = fade_pos or vector2()
	w:SetWndPos(fade_pos:set(512 - FADE_W / 2, topt.fade_y))
end

local orig_fade_check = nil
local function fade_check()
	local r = orig_fade_check()
	if topt.fade and not r then pcall(place_fade) end
	return r
end

local function patch_tasks()
	if not orig_send_task and news_manager and news_manager.send_task then
		orig_send_task = news_manager.send_task
		news_manager.send_task = send_task
	end
	if not orig_fade_msg and actor_menu and actor_menu.set_fade_msg then
		orig_fade_msg = actor_menu.set_fade_msg
		actor_menu.set_fade_msg = fade_msg
	end
	if not orig_fade_check and actor_menu and actor_menu.check_hud_fading_msg then
		orig_fade_check = actor_menu.check_hud_fading_msg
		actor_menu.check_hud_fading_msg = fade_check
	end
end

local function task_first_update()
	if topt.on then task_hud() end
end

local function task_net_destroy()
	if THUD then
		get_hud():RemoveDialogToRender(THUD)
		THUD = nil
	end
end

local N_PAD, N_IW, N_IH, N_W = 6, 62, 42, 400

local function n_static(view, tex, x1, y1, x2, y2)
	if x2 - x1 <= 0 or y2 - y1 <= 0 then return end
	local s = CUIStatic()
	s:SetAutoDelete(true)
	view:AttachChild(s)
	s:InitTexture(tex)
	s:SetStretchTexture(true)
	s:SetWndRect(Frect():set(x1, y1, x2, y2))
end

local function n_text(view, font, clr, x, y, w, h, txt, complex)
	local t = CUITextWnd()
	t:SetAutoDelete(true)
	view:AttachChild(t)
	t:SetFont(font)
	t:SetTextComplexMode(complex)
	if not complex then t:SetEllipsis(true) end
	t:SetWndRect(Frect():set(x, y, x + w, y + h))
	t:SetTextColor(clr)
	t:SetText(txt)
end

local function n_get(w)
	local t
	pcall(function() t = w:GetText() end)
	return t or ""
end

local function on_news(view, time_w, cap_w, msg_w, icon)
	if not (topt.news and view and time_w and cap_w and msg_w and icon) then return end
	local cap, msg, tm = n_get(cap_w), n_get(msg_w), n_get(time_w)
	local k = utils_xml.screen_ratio()
	local W, p = N_W * k, N_PAD * k
	local ix, iy, iw, ih = p, N_PAD, N_IW * k, N_IH
	local tx = ix + iw + 8 * k
	local mx, my, mw = p + 2 * k, iy + ih + 5, W - 2 * p - 4 * k
	local f16 = GetFontLetterica16Russian()
	local mh = 0
	if msg ~= "" then
		msg_w:SetFont(f16)
		msg_w:SetWndSize(vector2():set(mw, 16))
		msg_w:AdjustHeightToText()
		mh = math.max(16, msg_w:GetHeight())
	end
	local H = (mh > 0 and (my + mh) or (iy + ih)) + N_PAD
	time_w:Show(false)
	cap_w:Show(false)
	msg_w:Show(false)
	icon:SetWndRect(Frect():set(ix, iy, ix + iw, iy + ih))
	local B, L = "ui_rz_news_bg", "ui_rz_news_line"
	n_static(view, B, 0, 0, ix, H)
	n_static(view, B, ix + iw, 0, W, H)
	n_static(view, B, ix, 0, ix + iw, iy)
	n_static(view, B, ix, iy + ih, ix + iw, H)
	n_static(view, L, 0, 0, W, 1)
	n_static(view, L, 0, H - 1, W, H)
	n_static(view, L, 0, 1, k, H - 1)
	n_static(view, L, W - k, 1, W, H - 1)
	n_static(view, "ui_rz_news_frame", ix - 2 * k, iy - 2, ix + iw + 2 * k, iy + ih + 2)
	n_text(view, GetFontLetterica18Russian(), GetARGB(255, 255, 255, 255), tx, iy + 2, W - tx - p, 20, cap, false)
	n_text(view, f16, GetARGB(255, 150, 150, 145), tx, iy + 23, W - tx - p, 16, tm, false)
	if mh > 0 then
		n_text(view, f16, GetARGB(255, 215, 215, 210), mx, my, mw, mh, msg, true)
	end
	view:SetWndSize(vector2():set(view:GetWidth(), H + 3))
end

local function news_cb(view, time_w, cap_w, msg_w, icon)
	local ok, err = pcall(on_news, view, time_w, cap_w, msg_w, icon)
	if not ok then core.warn("ui: news %s", tostring(err)) end
end

local function news_hook()
	pcall(function() return callbacks_gameobject end)
	if type(rawget(_G, "CUIMessagesWindow__AddIconedPdaMessage")) ~= "function" then return end
	RegisterScriptCallback("on_news_received", news_cb)
end

function load()
	local g = core.page(PAGE)
	opt.msv = g("enabled") ~= false
	local t = core.page(TPAGE)
	topt.on = t("enabled") ~= false
	topt.y = tonumber(t("pos_y")) or 60
	topt.time = tonumber(t("time")) or 7
	topt.rows = math.max(1, math.floor(tonumber(t("rows")) or 3))
	topt.fade = t("fade_bottom") ~= false
	topt.fade_y = tonumber(t("fade_y")) or 625
	topt.news = t("news_style") ~= false
end

function on_game_start()
	patch()
	patch_tasks()
	news_hook()
	RegisterScriptCallback("actor_on_net_destroy", task_net_destroy)
	RegisterScriptCallback("actor_on_first_update", task_first_update)
	core.on_change(load)
	load()
end
