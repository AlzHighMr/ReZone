local core = rezone_core
local PAGE = rezone_mcm.path("rz_ranks")

VANILLA_MAX = 30000
DEFAULT_MAX = 150000

local V_RATING = { "novice", 3499, "trainee", 6499, "experienced", 8999, "professional", 11999, "veteran", 14499, "expert", 17499, "master", 26999, "legend" }
local V_KILL = { novice = 5, trainee = 6, experienced = 7, professional = 8, veteran = 9, expert = 10, master = 15, legend = 20 }
local V_SMART = { min = 1, max = 2 }

local RANGES = {
	stalker_0 = { 500, 3000 }, stalker_1 = { 3000, 6000 }, stalker_2 = { 6000, 10000 }, stalker_3 = { 10000, 20000 }, stalker_4 = { 22000, 30000 },
	bandit_0 = { 500, 3000 }, bandit_1 = { 1000, 3000 }, bandit_2 = { 3000, 6000 }, bandit_3 = { 6000, 15000 }, bandit_4 = { 10000, 20000 },
	duty_0 = { 900, 3000 }, duty_1 = { 3000, 6000 }, duty_2 = { 6000, 10000 }, duty_3 = { 10000, 20000 }, duty_4 = { 22000, 30000 },
	freedom_0 = { 1000, 3000 }, freedom_1 = { 3000, 6000 }, freedom_2 = { 6000, 10000 }, freedom_3 = { 10000, 20000 }, freedom_4 = { 22000, 30000 },
	csky_0 = { 500, 3000 }, csky_1 = { 3000, 6000 }, csky_2 = { 6000, 10000 }, csky_3 = { 10000, 20000 }, csky_4 = { 15000, 20000 },
	ecolog_0 = { 1000, 6000 }, ecolog_01 = { 1000, 6000 }, ecolog_1 = { 3000, 10000 }, ecolog_2 = { 6000, 10000 }, ecolog_3 = { 10000, 20000 },
	ecolog_4 = { 15000, 25000 }, ecolog_5 = { 20000, 30000 },
	killer_0 = { 2000, 5000 }, killer_1 = { 3000, 10000 }, killer_2 = { 6000, 10000 }, killer_3 = { 10000, 20000 }, killer_4 = { 22000, 30000 },
	killer_5 = { 26000, 30000 },
	military_0 = { 1000, 6000 }, military_1 = { 3000, 10000 }, military_2 = { 6000, 15000 }, military_3 = { 10000, 20000 }, military_4 = { 15000, 20000 },
	military_5 = { 26000, 30000 },
	monolith_0 = { 2000, 4000 }, monolith_1 = { 3000, 6000 }, monolith_2 = { 6000, 10000 }, monolith_3 = { 10000, 20000 }, monolith_4 = { 22000, 30000 },
	greh_0 = { 1000, 3000 }, greh_1 = { 3000, 6000 }, greh_2 = { 2000, 8000 }, greh_3 = { 5000, 10000 }, greh_4 = { 10000, 20000 },
	isg_0 = { 500, 2500 }, isg_1 = { 3000, 10000 }, isg_2 = { 6000, 10000 }, isg_3 = { 10000, 20000 }, isg_4 = { 22000, 30000 }, isg_5 = { 26000, 30000 },
	renegade_0 = { 500, 3000 }, renegade_1 = { 1000, 3000 }, renegade_2 = { 3000, 6000 }, renegade_3 = { 12000, 20000 }, renegade_4 = { 22000, 30000 },
	zombied_0 = { 500, 2500 }, zombied_1 = { 500, 3000 }, zombied_2 = { 3000, 10000 }, zombied_3 = { 10000, 20000 }, zombied_4 = { 15000, 22000 },
}

local SPECIAL = {
	stalker = { 10000, 20000 }, bandit = { 10000, 20000 }, dolg = { 10000, 20000 }, freedom = { 10000, 20000 },
	csky = { 10000, 20000 }, ecolog = { 10000, 20000 }, killer = { 10000, 20000 }, army = { 15000, 20000 },
	monolith = { 10000, 20000 }, greh = { 5000, 10000 }, isg = { 10000, 20000 }, renegade = { 1000, 3000 },
}

local cfg = { on = true, max = DEFAULT_MAX, mult = DEFAULT_MAX / VANILLA_MAX }
local foreign = false
local xml_done = {}
local init_cfg = false
local init_n = 0

local function read_cfg()
	local c = axr_main and axr_main.config
	local on, mx
	if c then
		on = c:r_value("mcm", PAGE .. "/enabled", 1)
		mx = c:r_value("mcm", PAGE .. "/max_rank", 2)
	end
	cfg.on = on ~= false
	cfg.max = math.max(VANILLA_MAX, math.min(300000, math.floor((tonumber(mx) or DEFAULT_MAX) / 1000 + 0.5) * 1000))
	cfg.mult = cfg.on and (cfg.max / VANILLA_MAX) or 1
end

local function scaled(v)
	return math.floor(v * cfg.mult + 0.5)
end

local function apply_ini()
	if not (ini_sys and ini_sys.set_readonly and ini_sys.w_string and ini_sys.set_override_names) then
		core.warn("hodnosti: exe neumi zapisovat do ini_sys - zebricek hodnosti zustava vanilla")
		return
	end
	local r, names = {}, {}
	for i = 1, #V_RATING do
		local v = V_RATING[i]
		if type(v) == "number" then
			v = tostring(math.floor((v + 1) * cfg.mult + 0.5) - 1)
			r[i], names[i] = v, v
		else
			r[i], names[i] = v, "st_rank_" .. v
		end
	end
	ini_sys:set_readonly(false)
	ini_sys:set_override_names(true)
	ini_sys:w_string("game_relations", "rating", table.concat(r, ", "))
	ini_sys:w_string("game_relations", "rating_names", table.concat(names, ", "))
	for k, v in pairs(V_KILL) do ini_sys:w_string("rank_kill_points", k, tostring(scaled(v))) end
	ini_sys:w_string("smart_terrain_rank_change", "min", tostring(scaled(V_SMART.min)))
	ini_sys:w_string("smart_terrain_rank_change", "max", tostring(scaled(V_SMART.max)))
	ini_sys:set_override_names(false)
	ini_sys:set_readonly(true)
	if ranks and ranks.read_all_ranks then pcall(ranks.read_all_ranks) end
end

local function find_range(id)
	local key = string.match(id, "^sim_default_(.-)_default_%d+$") or string.match(id, "^sim_default_(%w+_%d+)$")
	if key and RANGES[key] then return RANGES[key] end
	local fac, role = string.match(id, "^sim_default_(%w+)_(%a+)$")
	if fac and (role == "trader" or role == "mechanic" or role == "medic" or role == "barman") then return SPECIAL[fac] end
end

local function unq(v) return tonumber((string.gsub(tostring(v or ""), '"', ""))) end

local function scale_num(v)
	if not v or v <= 0 or v > VANILLA_MAX then return v end
	return math.min(scaled(v), cfg.max)
end

local function xml_ranks(xml_obj)
	local n = 0
	for _, sc in ipairs(xml_obj:query("specific_character") or {}) do
		local id = tostring((xml_obj:getElementAttr(sc) or {}).id or ""):gsub('"', "")
		for _, k in ipairs(sc.kids or {}) do
			if xml_obj:isElement(k) and xml_obj:getElementName(k) == "rank" then
				local a = xml_obj:getElementAttr(k) or {}
				local amin, amax = unq(a.min), unq(a.max)
				local rg = find_range(id)
				if amin or amax then
					if (amin and amin > VANILLA_MAX) or (amax and amax > VANILLA_MAX) then break end
					local nmin, nmax
					if rg then nmin, nmax = scaled(rg[1]), scaled(rg[2]) else nmin, nmax = scale_num(amin), scale_num(amax) end
					local na = {}
					for key, val in pairs(a) do na[key] = val end
					if amin then na.min = math.min(nmin or amin, cfg.max) end
					if amax then na.max = math.min(nmax or amax, cfg.max) end
					xml_obj:setElementAttr(k, na)
					xml_done[id] = true
					n = n + 1
				else
					local t = xml_obj.getText and xml_obj:getText(k)
					if t then
						local nums = {}
						for d in string.gmatch(t, "%d+") do nums[#nums + 1] = tonumber(d) end
						if #nums > 0 and nums[#nums] <= VANILLA_MAX then
							if rg and #nums >= 2 then
								xml_obj:setText(k, string.format("%d, %d", scaled(rg[1]), scaled(rg[2])))
							else
								xml_obj:setText(k, (string.gsub(t, "%d+", function(d) return tostring(scale_num(tonumber(d))) end)))
							end
							xml_done[id] = true
							n = n + 1
						end
					end
				end
				break
			end
		end
	end
	return n
end

local xml_log = {}

function xml_hook(xml_file_name, xml_obj)
	if not string.find(xml_file_name, "^gameplay[\\/]character_desc_") then return end
	if rawget(_G, "modxml_zzz_rank150k") then return end
	read_cfg()
	if not cfg.on or cfg.mult == 1 then return end
	local ok, n = pcall(xml_ranks, xml_obj)
	xml_log[#xml_log + 1] = { xml_file_name, ok, n }
end

function char_init(character_id, data)
	if not data or rawget(_G, "modxml_zzz_rank150k") then return end
	local id = tostring(character_id or "")
	if xml_done[id] then return end
	if not init_cfg then read_cfg() init_cfg = true end
	if not cfg.on or cfg.mult == 1 then return end
	local a, b = tonumber(data.rank_min), tonumber(data.rank_max)
	if not (a or b) then return end
	if (a and a > VANILLA_MAX) or (b and b > VANILLA_MAX) then return end
	local rg = find_range(id)
	local na, nb
	if rg then na, nb = scaled(rg[1]), scaled(rg[2]) else na, nb = scale_num(a), scale_num(b) end
	if a then data.rank_min = math.min(na or a, cfg.max) end
	if b then data.rank_max = math.min(nb or b, cfg.max) end
	init_n = init_n + 1
end

local function is_stalker(se)
	local cls = se and se.clsid and se:clsid()
	return cls and IsStalker and IsStalker(nil, cls)
end

local function set_npc_rank(id, se, factor, pending)
	local obj = level and level.object_by_id and level.object_by_id(id)
	if obj and obj.set_character_rank then
		obj:set_character_rank(math.floor(obj:character_rank() * factor + 0.5))
		return true
	end
	if se.set_rank and se.rank then
		local ok = pcall(se.set_rank, se, math.floor(se:rank() * factor + 0.5))
		if ok then return true end
	end
	pending[id] = (pending[id] or 1) * factor
	return false
end

local function migrate_npcs()
	local m = alife_storage_manager.get_state()
	if not m or not alife_object then return end
	if m.rz_rank_npc_mult and math.abs(m.rz_rank_npc_mult - cfg.mult) < 0.001 then return end
	local list, top = {}, 0
	for id = 1, 65534 do
		local se = alife_object(id)
		if se and is_stalker(se) and se.rank then
			local r = se:rank()
			list[#list + 1] = { id, se }
			if r > top then top = r end
		end
	end
	local old = m.rz_rank_npc_mult or ((top <= VANILLA_MAX * 1.02) and 1 or cfg.mult)
	local factor = cfg.mult / old
	m.rz_rank_pending = m.rz_rank_pending or {}
	local done_n, pend_n = 0, 0
	if math.abs(factor - 1) > 0.001 then
		for i = 1, #list do
			if set_npc_rank(list[i][1], list[i][2], factor, m.rz_rank_pending) then done_n = done_n + 1 else pend_n = pend_n + 1 end
		end
	end
	m.rz_rank_npc_mult = cfg.mult
	rezone_core.dbg("[ReZone] Hodnosti NPC: %d NPC, nejvyssi %d, nasobek x%.2f, zmeneno %d, ceka na online %d", #list, top, factor, done_n, pend_n)
end

local function fix_generic()
	local m = alife_storage_manager.get_state()
	if not m or not alife_object or cfg.mult == 1 then return end
	if m.rz_rank_gen_fix and math.abs(m.rz_rank_gen_fix - cfg.mult) < 0.001 then return end
	m.rz_rank_pending = m.rz_rank_pending or {}
	local p, done_n, pend_n = m.rz_rank_pending, 0, 0
	for id = 1, 65534 do
		local se = alife_object(id)
		if se and not p[id] and is_stalker(se) and se.rank then
			local key = string.match(se:section_name(), "^sim_default_(%a+_%d)$")
			local rg = key and RANGES[key]
			local r = se:rank()
			if rg and r <= VANILLA_MAX and r < scaled(rg[1]) then
				if set_npc_rank(id, se, cfg.mult, p) then done_n = done_n + 1 else pend_n = pend_n + 1 end
			end
		end
	end
	m.rz_rank_gen_fix = cfg.mult
	rezone_core.dbg("[ReZone] Hodnosti NPC: opraveno %d beznych NPC s neprepocitanou hodnosti, ceka na online %d", done_n, pend_n)
end

local function on_net_spawn(npc)
	local m = alife_storage_manager.get_state()
	local p = m and m.rz_rank_pending
	local f = p and npc and p[npc:id()]
	if f then
		npc:set_character_rank(math.floor(npc:character_rank() * f + 0.5))
		p[npc:id()] = nil
	end
end

local function rescale_actor()
	local m = alife_storage_manager.get_state()
	if not (m and db.actor) then return end
	local old = tonumber(m.rz_rank_mult)
	if old and math.abs(old - cfg.mult) > 0.001 and db.actor.set_character_rank then
		local r = db.actor:character_rank()
		db.actor:set_character_rank(math.floor(r * cfg.mult / old + 0.5))
		rezone_core.dbg("[ReZone] Hodnosti: maximum zmeneno, hodnost hrace %d -> %d", r, db.actor:character_rank())
	end
	m.rz_rank_mult = cfg.mult
	if cfg.on and not foreign then
		pcall(migrate_npcs)
		pcall(fix_generic)
	end
end

function enabled() return cfg.on and not foreign end
function max_rank() return cfg.max end

local function load()
	read_cfg()
	if foreign then return end
	apply_ini()
	if db.actor then pcall(rescale_actor) end
end

function on_game_start()

	if modxml_zzz_rank150k then
		foreign = true
		rezone_core.dbg("! ReZone Hodnosti: nalezen samostatny rank150k - ReZone hodnosti NPC nemeni, smaz ho")
		return
	end
	for i = 1, #xml_log do
		local e = xml_log[i]
		if e[2] then
			rezone_core.dbg("[ReZone] Hodnosti: %s - upraveno %d profilu (x%.2f)", e[1], e[3], cfg.mult)
		else
			rezone_core.dbg("! [ReZone] Hodnosti: %s - chyba %s", e[1], tostring(e[3]))
		end
	end
	xml_log = {}
	if init_n > 0 then rezone_core.dbg("[ReZone] Hodnosti: prepocitano %d postav pri nacteni profilu (x%.2f)", init_n, cfg.mult) end
	load()
	core.on_change(load)
	RegisterScriptCallback("actor_on_first_update", rescale_actor)
	RegisterScriptCallback("npc_on_net_spawn", on_net_spawn)
end
