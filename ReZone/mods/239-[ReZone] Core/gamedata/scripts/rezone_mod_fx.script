local core = rezone_core
local PAGE = rezone_mcm.ROOT .. "/" .. rezone_mcm.TAB_OT .. "/rz_fx"

local KEY_PSY = "psy_pp_effector_name"
local KEY_RAD = "radiation_pp_effector_name"
local KEY_DET = "detection_pp_effector_name"
local CLS_POLTER = "SM_POLTR"
local CLS_CONTR  = "SM_CONTR"
ZONE_PP = { "postprocess_rad" }
PSI_AURA = "rz_psi_aura"
PSI_PPE = "rz_psi\\psi_dog.ppe"
PSI_CLS = { SM_BURER = true, SM_POLTR = true, SM_CONTR = true }
PDOG_ON = { psy_max_distance = "12", psy_max_power = "0.5", psy_linear_factor = "0.08", psy_quadratic_factor = "0" }

local opt = { psi = true, voices = true }

local monsters = nil

local warned = false
local function can_write()
	return ini_sys and ini_sys.set_readonly and ini_sys.w_string and ini_sys.set_override_names and true or false
end

local function scan()
	if monsters then return end
	monsters = {}
	ini_sys:section_for_each(function(sec)
		local psy = ini_sys:line_exist(sec, KEY_PSY)
		local rad = ini_sys:line_exist(sec, KEY_RAD)
		local det = ini_sys:line_exist(sec, KEY_DET)
		if psy or rad or det then
			local cls = ini_sys:r_string_ex(sec, "class")
			local kind = ini_sys:r_string_ex(sec, "kind")
			local pdog = cls == "SM_P_DOG" and psy and (ini_sys:r_float_ex(sec, "psy_max_distance") or 0) == 0
			monsters[#monsters + 1] = { sec = sec, cls = cls, psy = psy, rad = rad, det = det,
				psi = PSI_CLS[cls] or kind == "SM_KARLIK", pdog = pdog }
		end
		return false
	end)
	core.log("efekty: %d sekci monster s efekty aury", #monsters)
end

local EMPTY = "<rz_empty>"
local function cur_value(sec, key)
	if not ini_sys:line_exist(sec, key) then return false end
	return ini_sys:r_string_ex(sec, key) or ""
end

local changed = 0
local function write(sec, key, v)
	local ok, err = pcall(ini_sys.w_string, ini_sys, sec, key, v, "")
	if ok then changed = changed + 1 else core.warn("efekty: zapis [%s] %s: %s", sec, key, tostring(err)) end
	return ok
end

local function set_v(sec, key, v)
	local okey = "rz_orig_" .. key
	local has = ini_sys:line_exist(sec, okey)
	local cur = cur_value(sec, key)
	if v ~= nil then
		if cur == false or cur == v then return end
		if not has then write(sec, okey, cur == "" and EMPTY or cur) end
		write(sec, key, v)
	else
		if not has then return end
		local ov = ini_sys:r_string_ex(sec, okey) or EMPTY
		if ov == EMPTY then ov = "" end
		if cur ~= ov then write(sec, key, ov) end
	end
end

local function set(sec, key, off_value, want)
	set_v(sec, key, want and off_value or nil)
end

local function apply(cfg)
	if not can_write() then
		if (cfg.rad or cfg.polter or cfg.contr or cfg.psy_other or cfg.psi) and not warned then
			warned = true
			core.warn("efekty: tato verze exe neumi menit nastaveni za behu (chybi modded exes)")
		end
		return
	end

	local any = cfg.rad or cfg.polter or cfg.contr or cfg.psy_other or cfg.psi
	local touched = ini_sys:section_exist(ZONE_PP[1]) and ini_sys:line_exist(ZONE_PP[1], "rz_fx_touched")
	if not any and not touched then return end
	scan()
	changed = 0
	ini_sys:set_readonly(false)
	ini_sys:set_override_names(true)
	local ok, err = pcall(function()
		for _, m in ipairs(monsters) do
			local is_p, is_c = m.cls == CLS_POLTER, m.cls == CLS_CONTR
			local own = (is_p and cfg.polter) or (is_c and cfg.contr)

			if m.psy then
				local off = own or (not is_p and not is_c and cfg.psy_other)
				if off then
					set_v(m.sec, KEY_PSY, "")
				elseif cfg.psi and (m.psi or m.pdog) then
					set_v(m.sec, KEY_PSY, PSI_AURA)
				else
					set_v(m.sec, KEY_PSY, nil)
				end
				if m.pdog then
					local on = cfg.psi and not cfg.psy_other
					for k, v in pairs(PDOG_ON) do set_v(m.sec, k, on and v or nil) end
				end
			end
			if m.rad then set(m.sec, KEY_RAD, "", (cfg.rad or own) and true or false) end
			if m.det then set(m.sec, KEY_DET, "", (is_p and cfg.polter) and true or false) end
		end
		for _, z in ipairs(ZONE_PP) do
			if ini_sys:section_exist(z) then
				set(z, "radius_min", "0", cfg.rad)
				set(z, "radius_max", "0", cfg.rad)
			end
		end
	end)
	if changed > 0 and ini_sys:section_exist(ZONE_PP[1]) then pcall(ini_sys.w_string, ini_sys, ZONE_PP[1], "rz_fx_touched", "1", "") end
	ini_sys:set_override_names(false)
	ini_sys:set_readonly(true)
	if not ok then core.warn("efekty: %s", tostring(err)) end
	if changed > 0 then core.log("efekty: zmeneno %d hodnot", changed) end
end

local function hook_fields()
	local m = sr_psy_antenna
	if not m or rawget(_G, "__rz_psi_fields") then return end
	local orig = m.set_scheme
	if type(orig) ~= "function" then return end
	rawset(_G, "__rz_psi_fields", true)
	m.set_scheme = function(npc, ini, scheme, section, ...)
		local r = orig(npc, ini, scheme, section, ...)
		if opt.psi then
			pcall(function()
				local st = db.storage[npc:id()][scheme]
				if st and st.postprocess == "psy_antenna.ppe" then st.postprocess = PSI_PPE end
			end)
		end
		return r
	end
end

local VOICES = "anomaly\\psy_voices_1_l"
local V_CHANCE, V_COOLDOWN, V_MS = 0.45, 25000, 8000
local V_OUT, V_IN = 0.55, 0.3
local v_snd, v_t0, v_vol, v_next = nil, nil, 1, 0

local function voices_stop()
	pcall(function() if v_snd and v_snd:playing() then v_snd:stop() end end)
	v_t0 = nil
end

local function voices()
	if not opt.voices then return end
	local now = time_global()
	if now < v_next or math.random() > V_CHANCE then return end
	v_next = now + V_COOLDOWN
	local ok, cover = pcall(GetEvent, "current_safe_cover")
	v_vol = (ok and cover) and V_IN or V_OUT
	pcall(function()
		if v_snd and v_snd:playing() then v_snd:stop() end
		v_snd = sound_object(VOICES)
		v_snd:play(db.actor, 0, sound_object.s2d)
		v_snd.volume = v_vol
	end)
	v_t0 = now
end

local function hook_storm()
	local cls = psi_storm_manager and psi_storm_manager.CPsiStormManager
	if not cls or rawget(_G, "__rz_psi_voices") then return end
	local orig = cls.kill_crows_at_pos
	if type(orig) ~= "function" then return end
	rawset(_G, "__rz_psi_voices", true)
	cls.kill_crows_at_pos = function(self, pos, ...)
		local r = orig(self, pos, ...)
		if db.actor and db.actor:alive() then pcall(voices) end
		return r
	end
end

local function voices_update()
	if not v_t0 then return end
	local k = 1 - (time_global() - v_t0) / V_MS
	if k <= 0 then return voices_stop() end
	pcall(function() if v_snd and v_snd:playing() then v_snd.volume = k * v_vol end end)
end

function load()
	local g = core.page(PAGE)
	opt.psi = g("psi_filter") ~= false
	opt.voices = g("psi_voices") ~= false
	apply({
		psi       = opt.psi,
		rad       = g("rad") == true,
		polter    = g("polter") == true,
		contr     = g("contr") == true,
		psy_other = g("psy_other") == true,
	})
end

function on_game_start()
	pcall(hook_fields)
	pcall(hook_storm)
	RegisterScriptCallback("actor_on_update", voices_update)
	RegisterScriptCallback("actor_on_net_destroy", voices_stop)
	core.on_change(load)
	load()
end
