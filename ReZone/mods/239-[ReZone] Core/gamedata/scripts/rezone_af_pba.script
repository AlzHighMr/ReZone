FAMILIES = {
	{ perk = "af_atom",        members = { "af_medusa", "af_vyvert", "af_baloon" } },
	{ perk = "af_peas",        members = { "af_night_star", "af_gravi", "af_gold_fish" } },
	{ perk = "af_black_angel", members = { "af_empty", "af_full_empty" } },
	{ perk = "af_signet",      members = { "af_cristall_flower", "af_lobster_eyes", "af_electra_moonlight", "af_black_spray" } },
	{ perk = "af_sun",         members = { "af_itcher", "af_pin", "af_cristall", "af_fireball" } },
	{ perk = "af_kislushka",   members = { "af_dummy_glassbeads", "af_eye", "af_fire" } },
	{ perk = "af_grapes",      members = { "af_blood", "af_mincer_meat", "af_bracelet" } },
	{ perk = "af_ear",         members = { "af_soul", "af_fuzz_kolobok", "af_glass" } },
	{ perk = "af_elektron",    members = { "af_electra_sparkler", "af_sponge", "af_ring", "af_electra_flash" } },
	{ perk = "af_generator",   members = { "af_dummy_battery", "af_dummy_dummy", "af_ice" } },
	{ perk = "af_fonar",       members = { "af_compass" } },
	{ perk = "af_signet",      members = { "af_oasis_heart" } },
	{ perk = "af_cocoon",      members = { "af_monolith" } },
}

local BREED_TYPES = { "rad", "cw", "reg", "tier" }

local function pba_present()
	local ok, fs = pcall(getFS)
	if (not ok) or (not fs) then return false end
	return fs:exist("$game_scripts$", "perk_based_artefacts.script") ~= nil
end

local done = false
function Inject()
	if (done) then return true end
	if (not pba_present()) then return false end
	local ok, props = pcall(function() return perk_based_artefacts.artefact_props end)
	if (not ok) or (type(props) ~= "table") then return false end
	local n = 0
	for _, f in ipairs(FAMILIES) do
		local p = props[f.perk]
		if (type(p) == "table") and (type(p.sections) == "table") then
			local top = f.members[#f.members]
			local function add(sec)
				if (ini_sys:section_exist(sec)) then p.sections[sec] = true n = n + 1 end
			end
			add(top)
			for _, t in ipairs(BREED_TYPES) do
				for lv = 1, 3 do add(top .. "_brd_" .. t .. lv) end
			end
			for _, m in ipairs(f.members) do add(m .. "_brd_tier3") end
		else
			if rezone_core then rezone_core.dbg("! ReZone Artefacts: PBA perk %s not found", f.perk) end
		end
	end
	done = true
	if rezone_core then rezone_core.dbg("ReZone Artefacts: %s sections got PBA perks", n) end
	return true
end

function GetPerk(sec)
	for _, f in ipairs(FAMILIES) do
		local top = f.members[#f.members]
		if (sec == top) or (string.find(sec, "^" .. top .. "_brd_")) then return f.perk end
		for _, m in ipairs(f.members) do
			if (sec == m .. "_brd_tier3") then return f.perk end
		end
	end
end

function on_game_start()
	Inject()

	RegisterScriptCallback("actor_on_first_update", function()
		Inject()
		pcall(function() perk_based_artefacts.force_refresh_state() end)
	end)
end
