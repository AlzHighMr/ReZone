function on_xml_read()
	RegisterScriptCallback("on_xml_read", function(xml_file_name, xml_obj)
		if rezone_mod_ranks and rezone_mod_ranks.xml_hook then rezone_mod_ranks.xml_hook(xml_file_name, xml_obj) end
	end)
	RegisterScriptCallback("on_specific_character_init", function(character_id, data)
		if rezone_mod_ranks and rezone_mod_ranks.char_init then rezone_mod_ranks.char_init(character_id, data) end
	end)
end