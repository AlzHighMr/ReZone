local core = rezone_core
local PAGE = rezone_mcm.path("rz_secrets")
local DBG_PAGE = rezone_mcm.path("rz_debug")

local INI_PATH   = [[plugins\secrets\base_secrets.ltx]]
local CHECK_TIME = 5000
local DEF_RADIUS = 3

local opt = { on = true, cam = false, key = DIK_keys.DIK_ADD }

local function log(fmt, ...) core.log("skryse: " .. fmt, ...) end
local function warn(fmt, ...) core.warn("skryse: " .. fmt, ...) end

local done    = {}
local pending = {}
local warned  = {}
local placed  = {}
local here    = {}
local miss    = {}

local cfg = nil

local function split(str, sep)
	local t = {}
	if not str then return t end
	for v in string.gmatch(str, "([^" .. sep .. "]+)") do
		v = v:gsub("^%s+", ""):gsub("%s+$", "")
		if v ~= "" then t[#t + 1] = v end
	end
	return t
end

local function range(str)
	local t = split(str, ",")
	local a = tonumber(t[1])
	if not a then return nil end
	return { a, tonumber(t[2]) or a }
end

local function parse_pos(str)
	local t = split(str, ",")
	if #t < 3 then return nil end
	local p = { x = tonumber(t[1]), y = tonumber(t[2]), z = tonumber(t[3]), lvid = tonumber(t[4]), gvid = tonumber(t[5]) }
	if not (p.x and p.y and p.z) then return nil end
	return p
end

local function parse_items(str, list)
	for _, e in ipairs(split(str, ",")) do
		local s = split(e, ":")
		if s[1] then
			list[#list + 1] = { sec = s[1], n = math.max(1, tonumber(s[2]) or 1), chance = tonumber(s[3]) or 1 }
		end
	end
end

local function level_of_gvid(gvid)
	if not gvid then return nil end
	local ok, name = pcall(function() return alife():level_name(game_graph():vertex(gvid):level_id()) end)
	return ok and name or nil
end

local function load_cfg()
	if cfg then return cfg end
	cfg = {}
	local ini = ini_file_ex(INI_PATH)
	if not ini then
		warn("chybi %s", INI_PATH)
		return cfg
	end
	for _, sec in pairs(ini:get_sections()) do
		local typ = ini:r_string_ex(sec, "type")
		if typ == "world" or typ == "box" or typ == "corpse" then
			local d = {
				name      = sec,
				typ       = typ,
				pos       = parse_pos(ini:r_string_ex(sec, "pos")),
				level     = ini:r_string_ex(sec, "level"),
				chance    = tonumber(ini:r_string_ex(sec, "chance")) or 1,
				cond      = range(ini:r_string_ex(sec, "cond")),
				uses      = range(ini:r_string_ex(sec, "uses")),
				ammo      = range(ini:r_string_ex(sec, "ammo")),
				condlist  = ini:r_string_ex(sec, "condlist"),
				box       = ini:r_string_ex(sec, "box"),
				radius    = tonumber(ini:r_string_ex(sec, "radius")) or DEF_RADIUS,
				container = ini:r_string_ex(sec, "container"),
				npc       = ini:r_string_ex(sec, "npc"),
				strip     = ini:r_bool_ex(sec, "strip", false),
				fix       = ini:r_bool_ex(sec, "fix", true),
				items     = {},
			}
			parse_items(ini:r_string_ex(sec, "item"), d.items)
			parse_items(ini:r_string_ex(sec, "items"), d.items)
			if d.condlist then d.condlist_p = xr_logic.parse_condlist(nil, sec, "condlist", d.condlist) end
			if (not d.level) and d.pos then d.level = level_of_gvid(d.pos.gvid) end

			local bad
			if #d.items == 0 then bad = "zadne item / items" end
			if (not d.pos) and not (typ == "box" and d.box) then bad = "chybi pos" end
			if typ ~= "box" and d.pos and not (d.pos.lvid and d.pos.gvid) then bad = "pos potrebuje x, y, z, lvid, gvid" end
			if typ == "corpse" and not (d.npc and ini_sys:section_exist(d.npc)) then bad = "npc chybi nebo neexistuje" end
			for _, it in ipairs(d.items) do
				if not ini_sys:section_exist(it.sec) then
					warn("[%s] predmet %s neexistuje - preskakuji", sec, it.sec)
					it.skip = true
				end
			end
			if bad then
				warn("[%s] %s - sekce se nespawnuje", sec, bad)
			else
				cfg[#cfg + 1] = d
			end
		end
	end
	table.sort(cfg, function(a, b) return a.name < b.name end)
	log("nacteno %d sekci", #cfg)
	return cfg
end

local function rnd_range(r, int)
	if not r then return nil end
	if int then return math.random(math.floor(r[1]), math.floor(r[2])) end
	return r[1] + (r[2] - r[1]) * math.random()
end

local function spawn_items(d, owner, ids)
	local n = 0
	for _, it in ipairs(d.items) do
		if not it.skip then
			for _ = 1, it.n do
				if math.random() <= it.chance then
					local ammo = IsItem("ammo", it.sec) and rnd_range(d.ammo, true) or nil
					local res = alife_create_item(it.sec, owner, (ammo and ammo > 0) and { ammo = ammo } or nil)
					local list = (type(res) == "table") and res or { res }
					for _, se in ipairs(list) do
						if se and se.id then
							n = n + 1
							if ids then ids[se.id] = true end
							local p = {}
							if IsItem("multiuse", it.sec) then
								p.u = rnd_range(d.uses, true)
							elseif d.cond and utils_item.is_degradable(nil, it.sec) then
								p.c = math.max(0.01, math.min(1, rnd_range(d.cond)))
							end
							if p.u or p.c then pending[se.id] = p end
							if d.typ == "world" and d.pos then
								placed[se.id] = { d.pos.x, d.pos.y, d.pos.z, d.fix }
								if d.level == level.name() then here[se.id] = placed[se.id] end
							end
						end
					end
				end
			end
		end
	end
	return n
end

local boxes = nil

local function all_boxes()
	if boxes then return boxes end
	boxes = {}
	local sim = alife()
	for i = 1, 65534 do
		local se = sim:object(i)
		if se and IsInvbox(nil, se:clsid()) then
			boxes[#boxes + 1] = { se = se, lvl = level_of_gvid(se.m_game_vertex_id) }
		end
	end
	return boxes
end

local function find_box(d)
	if d.box then
		local id = get_story_object_id and get_story_object_id(d.box)
		local se = id and alife_object(id) or alife():object(d.box)
		if se then return se end
		if not d.pos then return nil end
	end
	local pos = vector():set(d.pos.x, d.pos.y, d.pos.z)
	local best, best_d, near, near_d, any, any_d, any_l
	for _, b in ipairs(all_boxes()) do
		local se = b.se
		if alife_object(se.id) then
			local dist = se.position:distance_to(pos)
			if dist <= d.radius and ((not any_d) or dist < any_d) then any, any_d, any_l = se, dist, b.lvl end
			if (not d.level) or b.lvl == d.level then
				if dist <= d.radius and ((not best_d) or dist < best_d) then best, best_d = se, dist end
				if (not near_d) or dist < near_d then near, near_d = se, dist end
			end
		end
	end
	if (not best) and any then
		warn("[%s] box %s je v dosahu, ale v lokaci %s (ne %s) - opravit game_vertex_id / level", d.name, any:name(), any_l or "?", d.level or "?")
		best = any
	end
	if (not best) and not warned[d.name] then
		warned[d.name] = true
		if near then
			warn("[%s] zadny box do %.1f m (%s) - nejblizsi %s (%.1f m) na %.2f, %.2f, %.2f",
				d.name, d.radius, d.level or "?", near:name(), near_d, near.position.x, near.position.y, near.position.z)
		else
			warn("[%s] zadny box v lokaci %s", d.name, d.level or "?")
		end
	end
	return best
end

local function spawn_section(d)
	if d.chance < 1 and math.random() > d.chance then
		log("[%s] sance nevysla", d.name)
		return true
	end

	if d.typ == "world" then
		local n = spawn_items(d, { vector():set(d.pos.x, d.pos.y + 0.02, d.pos.z), d.pos.lvid, d.pos.gvid })
		log("[%s] world: %d predmetu", d.name, n)
		return true
	elseif d.typ == "box" then
		if miss[d.name] then return false end
		local box = find_box(d)
		if (not box) and d.container and d.pos and d.pos.lvid and d.pos.gvid then
			box = alife_create(d.container, vector():set(d.pos.x, d.pos.y, d.pos.z), d.pos.lvid, d.pos.gvid)
			if box then log("[%s] vytvoren box %s", d.name, d.container) end
		end
		if not box then miss[d.name] = true return false end
		local n = spawn_items(d, box)
		log("[%s] box %s: %d predmetu", d.name, box:name(), n)
		return true
	elseif d.typ == "corpse" then
		local se_npc = alife_create(d.npc, vector():set(d.pos.x, d.pos.y, d.pos.z), d.pos.lvid, d.pos.gvid)
		if not se_npc then
			warn("[%s] nelze vytvorit npc %s", d.name, d.npc)
			return true
		end
		local ids = {}
		local n = spawn_items(d, se_npc, ids)
		alife():kill_entity(se_npc)
		se_save_var(se_npc.id, se_npc:name(), "dont_release", true)
		if d.strip then pending[se_npc.id] = { strip = ids } end
		log("[%s] mrtvola %s (%s): %d predmetu", d.name, d.npc, se_npc.id, n)
		return true
	end
	return true
end

local function condlist_ok(d)
	if not d.condlist_p then return true end
	local r = xr_logic.pick_section_from_condlist(db.actor, db.actor, d.condlist_p)
	return r ~= nil and r ~= "false" and r ~= "nil"
end

local function try_spawn_all()
	if not (db.actor and alife()) then return end
	for _, d in ipairs(load_cfg()) do
		if not done[d.name] and condlist_ok(d) then
			local ok, res = pcall(spawn_section, d)
			if not ok then
				warn("[%s] chyba: %s", d.name, tostring(res))
				done[d.name] = true
			elseif res then
				done[d.name] = true
			end
		end
	end
end

local function rebuild_here()
	here = {}
	local lvl = level.name()
	for id, t in pairs(placed) do
		local se = alife_object(id)
		if not se then
			placed[id] = nil
		elseif level_of_gvid(se.m_game_vertex_id) == lvl then
			here[id] = t
		end
	end
end

local function process_placed()
	for id, t in pairs(here) do
		local obj = level.object_by_id(id)
		if obj then
			here[id] = nil
			placed[id] = nil
			if obj:parent() == nil then
				local want = vector():set(t[1], t[2], t[3])
				if obj:position():distance_to(want) > 0.05 and obj.force_set_position then
					pcall(obj.force_set_position, obj, want, true)
				end
				if t[4] ~= false then
					local sh = obj:get_physics_shell()
					if sh then
						for i = 0, sh:get_elements_number() - 1 do
							local el = sh:get_element_by_order(i)
							if el and not el:is_fixed() then el:fix() end
						end
					end
				end
				log("predmet %s (%s) umisten%s", obj:section(), id, t[4] ~= false and " a zamcen" or "")
			end
		elseif not alife_object(id) then
			here[id] = nil
			placed[id] = nil
		end
	end
end

local function process_pending()
	for id, p in pairs(pending) do
		local obj = level.object_by_id(id)
		if obj then
			if p.strip then
				local rel = {}
				obj:iterate_inventory(function(_, item)
					if not p.strip[item:id()] then rel[#rel + 1] = item:id() end
				end, obj)
				for _, iid in ipairs(rel) do alife_release_id(iid) end
			else
				if p.c and obj.set_condition then obj:set_condition(p.c) end
				if p.u and obj.set_remaining_uses then
					local max = obj.get_max_uses and obj:get_max_uses() or p.u
					obj:set_remaining_uses(math.max(1, math.min(p.u, max)))
				end
			end
			pending[id] = nil
		elseif not alife_object(id) then
			pending[id] = nil
		end
	end
end

local tmr = 0
local function actor_on_update()
	if next(here) then process_placed() end
	local t = time_global()
	if t < tmr then return end
	tmr = t + CHECK_TIME
	if next(pending) then process_pending() end
	if opt.on then try_spawn_all() end
end

local function actor_on_first_update()
	math.randomseed(os.time())
	tmr = time_global() + 2000
	boxes, miss = nil, {}
	rebuild_here()
end

function save_state(m_data)
	m_data.rz_secrets = { done = done, pending = pending, placed = placed }
end

function load_state(m_data)
	local s = m_data.rz_secrets
	if s then
		done = s.done or {}
		pending = s.pending or {}
		placed = s.placed or {}
		return
	end
	done, pending, placed = {}, {}, {}
	if m_data.world_spawn_done then
		for _, d in ipairs(load_cfg()) do
			if d.typ == "world" and not d.condlist then done[d.name] = true end
		end
	end
	if m_data.spawned_world_poss and m_data.spawned_world_poss[1] then
		done["old_escape_helm_respirator"] = true
	end
	m_data.world_spawn_done = nil
	m_data.spawned_world_poss = nil
	m_data.spawned_poss = nil
end

function reset(name)
	if not core.debug_on() then return end
	if name then done[name] = nil else done = {} end
	warned = {}
	miss = {}
	log("reset %s", name or "vse")
end

local SPEED     = 6
local LOOK_SENS = 0.004
local DRAG_SENS = 0.01
local NUDGE     = 0.05
local BOX_RANGE = 5

local LINE_BASE = 7731000
local lines = {}
local C_X = fcolor and fcolor():set(1, 0.2, 0.2, 1)
local C_Y = fcolor and fcolor():set(0.2, 1, 0.2, 1)
local C_Z = fcolor and fcolor():set(0.3, 0.5, 1, 1)
local C_B = fcolor and fcolor():set(1, 0.85, 0.1, 1)

local function get_line(i)
	if not (debug_render and DBG_ScriptObject) then return nil end
	if lines[i] == nil then
		local ok, l = pcall(function()
			return debug_render.add_object(LINE_BASE + i, DBG_ScriptObject.line):cast_dbg_line()
		end)
		lines[i] = ok and l or false
	end
	return lines[i] or nil
end

local function set_line(i, a, b, col)
	local l = get_line(i)
	if not l then return end
	l.point_a = a
	l.point_b = b
	l.color = col
	l.visible = true
end

local function hide_lines(from)
	for i, l in pairs(lines) do
		if l and i >= (from or 0) then l.visible = false end
	end
end

local function v(x, y, z) return vector():set(x, y, z) end

local BOX_EDGES = { {1,2},{2,3},{3,4},{4,1},{5,6},{6,7},{7,8},{8,5},{1,5},{2,6},{3,7},{4,8} }

local function draw_marker(p, b)
	local s = 0.35
	set_line(1, v(p.x - s, p.y, p.z), v(p.x + s, p.y, p.z), C_X)
	set_line(2, v(p.x, p.y - 0.05, p.z), v(p.x, p.y + 0.8, p.z), C_Y)
	set_line(3, v(p.x, p.y, p.z - s), v(p.x, p.y, p.z + s), C_Z)
	set_line(4, v(p.x - 0.1, p.y, p.z - 0.1), v(p.x + 0.1, p.y, p.z + 0.1), C_Y)
	set_line(5, v(p.x - 0.1, p.y, p.z + 0.1), v(p.x + 0.1, p.y, p.z - 0.1), C_Y)
	if b then
		local h = 0.3
		local c = {
			v(b.x - h, b.y, b.z - h), v(b.x + h, b.y, b.z - h), v(b.x + h, b.y, b.z + h), v(b.x - h, b.y, b.z + h),
			v(b.x - h, b.y + 2 * h, b.z - h), v(b.x + h, b.y + 2 * h, b.z - h), v(b.x + h, b.y + 2 * h, b.z + h), v(b.x - h, b.y + 2 * h, b.z + h),
		}
		for i, e in ipairs(BOX_EDGES) do set_line(10 + i, c[e[1]], c[e[2]], C_B) end
		set_line(30, p, b, C_B)
	else
		hide_lines(11)
	end
end

local function dir_hp(h, p) return vector():setHP(h, p) end

local function ray_hit(pos, dir, range)
	local rq = ray_pick()
	rq:set_position(pos)
	rq:set_direction(dir)
	rq:set_range(range or 200)
	rq:set_flags(3)
	if db.actor then rq:set_ignore_object(db.actor) end
	if rq:query() then
		local d = rq:get_distance()
		if d and d > 0 then return vector():mad(pos, dir, d) end
	end
end

local function nearest_box(p)
	local best, best_d
	local lvl = level.name()
	local sim = alife()
	for i = 1, 65534 do
		local se = sim:object(i)
		if se and IsInvbox(nil, se:clsid()) then
			local d = se.position:distance_to(p)
			if d <= BOX_RANGE and ((not best_d) or d < best_d) then
				local ln = level_of_gvid(se.m_game_vertex_id)
				if (not ln) or ln == lvl then best, best_d = se, d end
			end
		end
	end
	return best, best_d
end

local function fmt(n) return string.format("%.4f", n) end

local HUD_HELP, HUD_INFO = "rz_sec_cam_help", "rz_sec_cam_info"
local info_until = 0

local function hud_text(name, txt)
	local hud = get_hud()
	if not hud then return end
	local cs = hud:GetCustomStatic(name)
	if not txt then
		if cs then hud:RemoveCustomStatic(name) end
		return
	end
	if not cs then
		hud:AddCustomStatic(name, true)
		cs = hud:GetCustomStatic(name)
	end
	local w = cs and cs:wnd()
	local tc = w and w:TextControl()
	if tc then tc:SetText(txt) end
end

local function info(txt, ms)
	hud_text(HUD_INFO, txt)
	info_until = time_global() + (ms or 3000)
end

local CACHE = "cache_dbg.ltx"

local function report(p, box, box_d)
	local lvid = level.vertex_id(p)
	local gvid = db.actor:game_vertex_id()
	local lvl = level.name()
	local pos = string.format("%s, %s, %s, %s, %s", fmt(p.x), fmt(p.y), fmt(p.z), lvid, gvid)
	local in_box = box and box_d <= DEF_RADIUS
	local sec
	local ok, err = pcall(function()
		local ini = ini_file_ex(CACHE, true)
		local n = 1
		while ini:section_exist("rz_sec_" .. lvl .. "_" .. n) do n = n + 1 end
		sec = "rz_sec_" .. lvl .. "_" .. n
		ini:w_value(sec, "type", in_box and "box" or "world")
		ini:w_value(sec, "level", lvl)
		ini:w_value(sec, "pos", pos)
		if in_box then ini:w_value(sec, "box", box:name()) end
		ini:save()
		if ui_debug_launcher and ui_debug_launcher.ini_cc then ui_debug_launcher.ini_cc = ini_file_ex(CACHE, true) end
	end)
	if not ok then warn("zapis do %s selhal: %s", CACHE, tostring(err)) end
	local txt = string.format("[%s] pos = %s", sec or "?", pos)
	if box then txt = txt .. string.format("\nbox %s (%.2f m)", box:name(), box_d) end
	if lvid == 4294967295 or lvid == -1 then txt = txt .. "\n" .. game.translate_string("st_rz_sec_cam_badlv") end
	printf("[ReZone] skryse: %s", txt)
	info(txt, 8000)
end

local cam = nil
local held = {}

local function down(dik)
	if key_state then
		local ok, r = pcall(key_state, dik)
		if ok and r ~= nil then return r == true or r == 1 end
	end
	return held[dik] == true
end

local function cam_apply()
	level.set_cam_custom_position_direction(cam.pos, vector():set(cam.h * cam.sign[1], cam.p * cam.sign[2], 0), 0, false, false)
end

local function cam_flat()
	local flat = dir_hp(cam.h, 0)
	return flat, vector():set(flat.z, 0, -flat.x)
end

local function cam_help()
	local m = cam.marker
	hud_text(HUD_HELP, string.format(
		"%s | %s | %.2f, %.2f, %.2f%s\n%s",
		game.translate_string("st_rz_sec_cam"), level.name(), m.x, m.y, m.z,
		cam.box and string.format(" | box %s (%.2f m)", cam.box:name(), cam.box_d) or "",
		game.translate_string("st_rz_sec_cam_help")))
end

local function cam_stop()
	if not cam then return end
	cam = nil
	held = {}
	hide_lines()
	pcall(level.remove_cam_custom_position_direction)
	level.enable_input()
	hud_text(HUD_HELP, nil)
	hud_text(HUD_INFO, nil)
end

local function cam_update()
	if not cam then return end
	local t = time_global()
	local dt = math.min(0.1, (t - cam.last_t) / 1000)
	cam.last_t = t
	local K = DIK_keys

	if cam.calib then
		cam.calib_wait = (cam.calib_wait or 3) - 1
		if cam.calib_wait <= 0 then
			cam.calib_wait = 3
			if dir_hp(cam.h, cam.p):dotproduct(device().cam_dir) > 0.98 then
				cam.calib = nil
			else
				cam.calib = cam.calib + 1
				local tr = ({ {1, 1}, {-1, 1}, {1, -1}, {-1, -1} })[cam.calib]
				if tr then cam.sign = { tr[1], tr[2] } else cam.calib = nil cam.sign = { 1, 1 } end
			end
		end
	end

	local fast = down(K.DIK_LSHIFT) and not down(K.MOUSE_1)
	local spd = SPEED * (fast and 4 or 1) * (down(K.DIK_LCONTROL) and 0.25 or 1) * dt
	local fwd = dir_hp(cam.h, cam.p)
	local _, right = cam_flat()
	if down(K.DIK_W) then cam.pos:mad(fwd, spd) end
	if down(K.DIK_S) then cam.pos:mad(fwd, -spd) end
	if down(K.DIK_D) then cam.pos:mad(right, spd) end
	if down(K.DIK_A) then cam.pos:mad(right, -spd) end
	if down(K.DIK_E) then cam.pos.y = cam.pos.y + spd end
	if down(K.DIK_Q) then cam.pos.y = cam.pos.y - spd end
	local rs = 1.5 * dt
	if down(K.DIK_NUMPAD4) then cam.h = cam.h + rs end
	if down(K.DIK_NUMPAD6) then cam.h = cam.h - rs end
	if down(K.DIK_NUMPAD8) then cam.p = math.min(1.5, cam.p + rs) end
	if down(K.DIK_NUMPAD2) then cam.p = math.max(-1.5, cam.p - rs) end

	cam_apply()
	if cam.show_marker then draw_marker(cam.marker, cam.box and cam.box.position) else hide_lines() end
	if t > (cam.help_t or 0) then
		cam.help_t = t + 250
		cam_help()
	end
	if info_until > 0 and t > info_until then
		info_until = 0
		hud_text(HUD_INFO, nil)
	end
end

local function nudge(dx, dy, dz)
	local fine = down(DIK_keys.DIK_LCONTROL) and 0.2 or 1
	local flat, right = cam_flat()
	cam.marker:mad(right, dx * NUDGE * fine)
	cam.marker:mad(flat, dz * NUDGE * fine)
	cam.marker.y = cam.marker.y + dy * NUDGE * fine
	cam.help_t = 0
end

local function cam_mouse(x, y, dis, flags)
	if not cam then return end
	if flags then flags.ret_value = false end
	x, y = x or 0, y or 0
	if down(DIK_keys.MOUSE_1) then
		local k = DRAG_SENS * (down(DIK_keys.DIK_LCONTROL) and 0.1 or 1)
		local flat, right = cam_flat()
		if down(DIK_keys.DIK_LSHIFT) then
			cam.marker.y = cam.marker.y - y * k
		else
			cam.marker:mad(right, x * k)
			cam.marker:mad(flat, -y * k)
		end
		cam.box = nil
		cam.help_t = 0
	else
		local sens = LOOK_SENS * (get_console_cmd(2, "mouse_sens") or 0.12) / 0.12
		cam.h = cam.h - x * sens
		cam.p = math.max(-1.5, math.min(1.5, cam.p - y * sens))
	end
end

local function cam_start()
	if not (level.set_cam_custom_position_direction and level.remove_cam_custom_position_direction) then
		actor_menu.set_msg(1, game.translate_string("st_rz_sec_cam_noexe"), 5)
		return
	end
	local d = device().cam_dir
	cam = {
		pos = vector():set(device().cam_pos),
		h = d:getH(), p = d:getP(),
		sign = { 1, 1 }, calib = 1,
		show_marker = true,
		last_t = time_global(),
	}
	cam.marker = ray_hit(cam.pos, d, 50) or vector():mad(cam.pos, d, 3)
	held = {}
	hide_hud_inventory()
	level.disable_input()
	cam_apply()
	cam_help()
end

local function cam_key(key, bind, dis, flags)
	held[key] = true
	if not cam then
		if key == opt.key and db.actor and db.actor:alive() then
			cam_start()
			if flags then flags.ret_value = false end
		end
		return
	end
	if flags then flags.ret_value = false end
	local K = DIK_keys
	if key == opt.key or key == K.DIK_ESCAPE then
		cam_stop()
		return
	elseif key == K.DIK_F then
		local hit = ray_hit(cam.pos, dir_hp(cam.h, cam.p), 300)
		if hit then cam.marker = hit cam.box = nil end
	elseif key == K.DIK_B then
		cam.box, cam.box_d = nearest_box(cam.marker)
		if cam.box then
			cam.marker = vector():set(cam.box.position)
			cam.box_d = 0
		else
			info(string.format(game.translate_string("st_rz_sec_cam_nobox"), BOX_RANGE), 2500)
		end
	elseif key == K.DIK_RETURN or key == K.DIK_NUMPADENTER then
		local box, bd = nearest_box(cam.marker)
		report(cam.marker, box, bd)
		return
	elseif key == K.DIK_M then
		cam.show_marker = not cam.show_marker
	elseif key == K.DIK_LEFT then nudge(-1, 0, 0)
	elseif key == K.DIK_RIGHT then nudge(1, 0, 0)
	elseif key == K.DIK_UP then nudge(0, 0, 1)
	elseif key == K.DIK_DOWN then nudge(0, 0, -1)
	elseif key == K.DIK_PRIOR then nudge(0, 1, 0)
	elseif key == K.DIK_NEXT then nudge(0, -1, 0)
	end
	if cam then cam.help_t = 0 end
end

local function cam_key_release(key, bind, dis, flags)
	held[key] = nil
	if cam and flags then flags.ret_value = false end
end

local function cam_key_up(key) held[key] = nil end

local function cam_key_hold(key, bind, dis, flags)
	if cam and flags then flags.ret_value = false end
end

local function cam_net_destroy() cam_stop() end
local function cam_level_change() cam_stop() end

local CAM_CB = {
	{ "on_before_key_press", cam_key },
	{ "on_before_key_release", cam_key_release },
	{ "on_key_release", cam_key_up },
	{ "on_before_key_hold", cam_key_hold },
	{ "on_before_mouse_move", cam_mouse },
	{ "actor_on_update", cam_update },
	{ "actor_on_net_destroy", cam_net_destroy },
	{ "on_before_level_changing", cam_level_change },
}

local cam_ok = nil
local function cam_supported()
	if cam_ok == nil then
		cam_ok = core.has_callback("on_before_key_press") and core.has_callback("on_before_mouse_move")
		if not cam_ok then warn("kamera potrebuje modded exes (on_before_key_press / on_before_mouse_move)") end
	end
	return cam_ok
end

function load()
	local g = core.page(PAGE)
	local dg = core.page(DBG_PAGE)
	opt.on = g("enabled") ~= false
	opt.cam = dg("sec_cam") == true
	opt.key = tonumber(dg("sec_key")) or DIK_keys.DIK_ADD
	local want = opt.cam and cam_supported()
	if not want then cam_stop() end
	for i = 1, #CAM_CB do core.toggle_cb(CAM_CB[i][1], CAM_CB[i][2], want) end
	log("%s, kamera %s", opt.on and "zapnuto" or "vypnuto", want and "zapnuta" or "vypnuta")
end

function on_game_start()
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	RegisterScriptCallback("actor_on_update", actor_on_update)
	RegisterScriptCallback("save_state", save_state)
	RegisterScriptCallback("load_state", load_state)
	core.on_change(load)
	load()
end
