    <text>Neobvyklé maso</text>
</string>
<string id="st_kolbasa_strange_unpacked_description">
    <text>Páchnoucí maso neznámého původu. Nepoznáváš vzhled ani vůni...\n \n
    %c[ui_gray_3]VLASTNOSTI:\n
    %c[d_red] • %c[ui_gray_2] nízká kvalita\n</text>
</string>

<string id="st_kolbasa_strange_paper_name">
    <text>Popsaný papír</text>
</string>
<string id="st_kolbasa_strange_paper_descr">
    <text>Zapáchající papír, který byl obalen kolem neobvyklého masa. Něco bylo na něj napsáno, ale nepoznáváš moc. </text>
</string>

