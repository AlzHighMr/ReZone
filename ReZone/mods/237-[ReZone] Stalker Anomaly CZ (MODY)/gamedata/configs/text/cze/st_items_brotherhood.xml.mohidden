</string>

<string id="st_pda_mercenary_1_name">
    <text>PDA poručíka Haralda Virtanena</text>
</string>
<string id="st_pda_mercenary_1_descr">
    <text>PDA poručíka Haralda Virtanena s dešifrovacím klíčem pro komunikaci námezdníků.\n \nBude brzy zastaralé.</text>
