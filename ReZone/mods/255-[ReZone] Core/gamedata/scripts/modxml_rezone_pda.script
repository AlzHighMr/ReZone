local PATH = "rezone/rz_other/rz_pda/"
local FILES = {
	["ui\\map_spots.xml"] = true, ["ui\\map_spots_16.xml"] = true,
	["ui\\map_spots_relations.xml"] = true,	-- tady je deadbody_mini_spot ve vanille
}

local function get(key, def)
	if not ui_mcm then return def end
	local ok, v = pcall(ui_mcm.get, PATH .. key)
	if not ok or v == nil then return def end
	return v
end

local function show_corpses() return get("corpses", true) ~= false end

------------------------------------------------------------
-- Trvale tecky mrtvol: kazda postava i mutant, ktery zemre v okoli, dostane tecku na minimape
-- (bez ohledu na dosah PDA). Zmizi, az mrtvolu prohledas. Spot "deadbody_location" je ukladany.
------------------------------------------------------------
local SPOT = "deadbody_location"

local function keep_dots() return show_corpses() and get("corpses_keep", false) == true end

local function add_dot(victim)
	if not (victim and keep_dots()) then return end
	local id = victim:id()
	if level.map_has_object_spot(id, SPOT) == 0 then
		level.map_add_object_spot_ser(id, SPOT, "")
	end
end

local function remove_dot(obj)
	if not obj then return end
	local id = obj:id()
	-- engine nekdy odebere jen jednu ze dvou vrstev spotu -> mazat, dokud tam je
	for _ = 1, 3 do
		if level.map_has_object_spot(id, SPOT) == 0 then break end
		level.map_remove_object_spot(id, SPOT)
	end
end

function on_game_start()
	RegisterScriptCallback("npc_on_death_callback", add_dot)
	RegisterScriptCallback("monster_on_death_callback", add_dot)
	RegisterScriptCallback("npc_on_use", function(obj) if keep_dots() then remove_dot(obj) end end)
	RegisterScriptCallback("monster_on_actor_use_callback", function(obj) if keep_dots() then remove_dot(obj) end end)
end

function on_xml_read()
	RegisterScriptCallback("on_xml_read", function(xml_file_name, xml_obj)
		if not FILES[xml_file_name] or show_corpses() then return end
		local res = xml_obj:query("deadbody_mini_spot")
		for _, el in ipairs(res or {}) do
			xml_obj:setElementAttr(el, { width = 0, height = 0 })
		end
		if rezone_core and rezone_core.DEBUG then
			printf("[ReZone PDA] mrtvoly na minimape skryty (%s, %d)", xml_file_name, res and #res or 0)
		end
	end)
end
