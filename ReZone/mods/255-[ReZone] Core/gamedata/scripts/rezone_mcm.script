local function main_master()
	local content = {}
	for i = 0, #rezone_master.NAMES do content[#content + 1] = { i, "rz_master_" .. rezone_master.NAMES[i] } end
	return page("rz_master", {
		slide("ui_mcm_rz_master_title"),
		desc("d", "ui_mcm_rz_master_info"),
		line("l1"),
		{ id = "master", type = "list", val = 2, def = 0, content = content, hint = "rz_master" },
		line("l2"),
		desc("d1", "ui_mcm_rz_master_cop_info"),
		desc("d2", "ui_mcm_rz_master_trilogy_info"),
		desc("d3", "ui_mcm_rz_master_hardcore_info"),
		line("l3"),
		desc("n", "ui_mcm_rz_master_note", CLR_NOTE),
	})
end

------------------------------------------------------------
function build_tree()
	local L = rezone_links
	local gp = { gp_trade(), gp_prices(), gp_loot() }
	if rezone_mod_afspawn then gp[#gp + 1] = gp_afspawn() end
	if rezone_mod_population then gp[#gp + 1] = gp_population() end
	if rezone_mod_wander then rezone_mod_wander.read_cfg(); gp[#gp + 1] = gp_wander() end
	gp[#gp + 1] = gp_ballistics()
	gp[#gp + 1] = gp_craft()
	gp[#gp + 1] = L.build_page(TAB_GP)
	return {
		id = ROOT,
		gr = {
			{ id = TAB_MAIN, gr = { main_master() } },
			{ id = TAB_GP, gr = gp },
			{ id = TAB_HP, gr = { hp_damage(), hp_mutants(), hp_mutdmg(), hp_artefacts(), L.build_page(TAB_HP) } },
			{ id = TAB_OT, gr = { ot_fx(), ot_menu(), L.build_page(TAB_OT), ot_debug() } },
		},
	}
end

function on_mcm_load()
	rezone_links.reset() -- znovu nacist LTX pri kazdem sestaveni MCM
	-- predvolba hry musi oznacit vsechny volby i v hlavnim menu (on_game_start tam nebezi)
	if rezone_master and rezone_master.hook_gui then pcall(rezone_master.hook_gui) end
	-- video v hlavnim menu: zmena hned po Pouzit i bez nacteni hry
	if modxml_rezone_mm_video and modxml_rezone_mm_video.ensure_live then pcall(modxml_rezone_mm_video.ensure_live) end
	return build_tree()
end
