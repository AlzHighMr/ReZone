-- Artefakty (rezone_af_punish, rezone_af_fx): chemicke a elektricke artefakty bez kontejneru
local function hp_artefacts()
	return page("rz_af", {
		slide("ui_mcm_menu_rzaf"),
		desc("d", "ui_mcm_rzaf_desc"),
		line("l1"),
		check("punish", true, "rzaf_punish"),
		track("punish_chance", 1, 0, 3, 0.05, "rzaf_punish_chance"),
		track("punish_strength", 1, 0, 3, 0.05, "rzaf_punish_strength"),
		line("l2"),
		check("poison_fx", true, "rzaf_poison_fx"),
		track("poison_fx_strength", 0.5, 0, 1.5, 0.05, "rzaf_poison_fx_strength"),
		check("electro_fx", true, "rzaf_electro_fx"),
		track("electro_fx_strength", 0.5, 0, 1.5, 0.05, "rzaf_electro_fx_strength"),
		line("l3"),
		desc("dh", "ui_mcm_rzaf_heal_info"),
		check("efth_heal", true, "rzaf_efth_heal"),
		track("efth_heal_mult", 1, 0, 3, 0.05, "rzaf_efth_heal_mult"),
	})
end

local function hp_damage()
	local pr = rezone_presets
	local content = {}
	for i = 1, #pr.NAMES do
		content[#content + 1] = { i, "rz_pd_" .. pr.NAMES[i] }
	end

	local gr = {
		slide("ui_mcm_rz_pdmg_title"),
		desc("d", "ui_mcm_rz_pdmg_info"),
		line("l1"),
		{ id = "preset", type = "preset", val = 2, def = pr.DEFAULT, content = content, presets = pr.PRESETS, hint = "rz_pdmg_preset" },
		desc("cn", "ui_mcm_rz_pdmg_cop_note", CLR_NOTE),
		line("l3"),
		desc("d_hit", "ui_mcm_rz_pdmg_hits"),
	}
	for i = 1, #pr.HIT_TYPES do
		local k = pr.HIT_TYPES[i]
		local def = pr.PRESETS[pr.DEFAULT][k] or 1
		gr[#gr + 1] = track(k, def, 0, 3, 0.05, "rz_hit_" .. k)
	end
	return page("rz_pdmg", gr)
end

local function hp_mutants()
	local gr = {
		slide("ui_mcm_rz_muthp_title"),
		desc("d", "ui_mcm_rz_muthp_info"),
		line("l1"),
		check("enabled", false, "rz_muthp_enabled"),
		track("all", 1, 0.25, 3, 0.05, "rz_muthp_all"),
		line("l2"),
	}
	for i = 1, #MUTANT_SPECIES do
		local s = MUTANT_SPECIES[i]
		gr[#gr + 1] = track(s, 1, 0.25, 3, 0.05, "rz_sp_" .. s)
	end
	local rs = false
	for i = 1, #RS_SPECIES do
		if rs_installed(RS_SPECIES[i][2]) then
			if not rs then rs = true; gr[#gr + 1] = line("l_rs"); gr[#gr + 1] = desc("d_rs", "ui_mcm_rz_muthp_rs") end
			gr[#gr + 1] = track(RS_SPECIES[i][1], 1, 0.25, 3, 0.05, "rz_sp_" .. RS_SPECIES[i][1])
		end
	end
	return page("rz_muthp", gr)
end

-- Sila utoku mutantu: nasobic poskozeni, ktere mutant da hraci (podle druhu)
local function hp_mutdmg()
	local gr = {
		slide("ui_mcm_rz_mutdmg_title"),
		desc("d", "ui_mcm_rz_mutdmg_info"),
		line("l1"),
		check("enabled", false, "rz_mutdmg_enabled"),
		track("all", 1, 0.1, 3, 0.05, "rz_mutdmg_all"),
		line("l2"),
	}
	for i = 1, #MUTANT_SPECIES do
		local s = MUTANT_SPECIES[i]
		gr[#gr + 1] = track(s, 1, 0.1, 3, 0.05, "rz_sp_" .. s)
	end
	local rs = false
	for i = 1, #RS_SPECIES do
		if rs_installed(RS_SPECIES[i][2]) then
			if not rs then rs = true; gr[#gr + 1] = line("l_rs"); gr[#gr + 1] = desc("d_rs", "ui_mcm_rz_muthp_rs") end
			gr[#gr + 1] = track(RS_SPECIES[i][1], 1, 0.1, 3, 0.05, "rz_sp_" .. RS_SPECIES[i][1])
		end
	end
	return page("rz_mutdmg", gr)
end

