local function migrate_tabs(tabs)
	local c = axr_main and axr_main.config
	if not c or c:r_value("rezone_internal", "tabs_v246", 1, false) then return end
	local n = 0
	for _, tab in ipairs(tabs) do
		for _, pg in ipairs(tab.gr) do
			local old = OLD_TAB[pg.id]
			for _, o in ipairs(old and pg.gr or {}) do
				if o.id and o.type and o.type ~= "slide" and o.type ~= "desc" and o.type ~= "line" and o.type ~= "button" then
					local typ = o.val or 0
					local v = c:r_value("mcm", ROOT .. "/" .. old .. "/" .. pg.id .. "/" .. o.id, typ)
					local new = path(pg.id) .. "/" .. o.id
					if v ~= nil and c:r_value("mcm", new, typ) == nil then
						c:w_value("mcm", new, v)
						n = n + 1
					end
				end
			end
		end
	end
	c:w_value("rezone_internal", "tabs_v246", true)
	c:save()
	if n > 0 then rezone_core.dbg("[ReZone] MCM: prevedeno %d ulozenych voleb do novych zalozek", n) end
end

local STHP_IDS = { "enabled", "all", "novice", "trainee", "experienced", "professional", "veteran", "expert", "master", "legend" }
local function migrate_sthp()
	local c = axr_main and axr_main.config
	if not c or c:r_value("rezone_internal", "sthp_v257", 1, false) then return end
	local function get(paths, typ)
		for _, pth in ipairs(paths) do
			local v = c:r_value("mcm", pth, typ)
			if v ~= nil then return v end
		end
	end
	local base = path("rz_ball") .. "/st_"
	for _, id in ipairs(STHP_IDS) do
		local typ = id == "enabled" and 1 or 2
		local v = get({ ROOT .. "/" .. TAB_COMBAT .. "/rz_sthp/" .. id, ROOT .. "/rz_health/rz_sthp/" .. id }, typ)
		if v ~= nil and c:r_value("mcm", base .. id, typ) == nil then c:w_value("mcm", base .. id, v) end
	end
	local nt = get({ path("rz_ball") .. "/npc_tough", ROOT .. "/rz_gameplay/rz_ball/npc_tough" }, 2)
	if nt and math.abs(nt - 1) > 0.001 then
		local all = c:r_value("mcm", base .. "all", 2) or 1
		c:w_value("mcm", base .. "all", all * nt)
		c:w_value("mcm", base .. "enabled", true)
		rezone_core.dbg("[ReZone] Odolnost NPC z balistiky (%.2f) prevedena do Odolnost stalkeru", nt)
	end
	c:w_value("rezone_internal", "sthp_v257", true)
	c:save()
end

local function clean_old(tabs)
	local c = axr_main and axr_main.config
	if not (c and c.collect_section and c.remove_line) then return end
	if c:r_value("rezone_internal", "clean_v260", 1, false) then return end
	local valid = {}
	local function walk(n, pth)
		local cur = pth .. "/" .. n.id
		if n.gr then
			for _, x in ipairs(n.gr) do walk(x, cur) end
		else
			valid[cur] = true
		end
	end
	for _, tab in ipairs(tabs) do walk(tab, ROOT) end
	local all = c:collect_section("mcm") or {}
	local n = 0
	for k in pairs(all) do
		if type(k) == "string" and k:find("^" .. ROOT .. "/") and not valid[k] then
			c:remove_line("mcm", k)
			n = n + 1
		end
	end
	if c:line_exist("rezone_internal", "pop_tab_moved") then c:remove_line("rezone_internal", "pop_tab_moved") end
	c:w_value("rezone_internal", "clean_v260", true)
	c:save()
	if n > 0 then rezone_core.dbg("[ReZone] MCM: smazano %d starych ulozenych voleb", n) end
end

local function add(t, cond, fn)
	if cond then t[#t + 1] = fn() end
end

function build_tree()
	local eco, combat, world, surv = {}, {}, {}, {}
	add(eco, true, gp_trade)
	add(eco, true, gp_prices)
	add(eco, true, gp_loot)
	add(eco, true, gp_craft)

	add(combat, true, gp_ballistics)
	add(combat, true, hp_mutants)
	add(combat, true, hp_damage)
	add(combat, true, hp_mutdmg)
	add(combat, true, gp_vision)

	add(world, rezone_mod_population, gp_population)
	if rezone_mod_wander then rezone_mod_wander.read_cfg() end
	add(world, rezone_mod_wander, gp_wander)
	add(world, rezone_mod_afspawn, gp_afspawn)
	add(world, rezone_mod_hunt, gp_hunt)
	add(world, rezone_mod_ranks, gp_ranks)
	add(world, rezone_secrets, gp_secrets)

	add(surv, true, gp_meds)
	add(surv, true, gp_needs)
	add(surv, true, hp_artefacts)

	local tabs = {
		{ id = TAB_MAIN, gr = { main_master(), rezone_links.build_page() } },
		{ id = TAB_ECO, gr = eco },
		{ id = TAB_COMBAT, gr = combat },
		{ id = TAB_WORLD, gr = world },
		{ id = TAB_SURV, gr = surv },
		{ id = TAB_OT, gr = { ot_fx(), ot_hud(), ot_binoc(), ot_pda(), ot_menu(), ot_debug() } },
	}
	pcall(migrate_tabs, tabs)
	pcall(migrate_sthp)

	if db and db.actor then pcall(clean_old, tabs) end
	return { id = ROOT, gr = tabs }
end

function on_mcm_load()
	rezone_links.reset()

	if rezone_master and rezone_master.hook_gui then pcall(rezone_master.hook_gui) end

	if modxml_rezone_mm_video and modxml_rezone_mm_video.ensure_live then pcall(modxml_rezone_mm_video.ensure_live) end
	return build_tree()
end
