		check("enabled", true, "rz_needs_enabled"),
		track("hunger", 1, 0, 3, 0.05, "rz_needs_hunger"),
		track("thirst", 1, 0, 3, 0.05, "rz_needs_thirst"),
		track("sleep", 1, 0, 3, 0.05, "rz_needs_sleep"),
		line("l2"),
		desc("n", "ui_mcm_rz_needs_note", CLR_NOTE),
	})
end

