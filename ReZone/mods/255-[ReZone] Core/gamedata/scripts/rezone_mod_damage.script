local core = rezone_core
local PAGE = rezone_mcm.path("rz_pdmg")
local EPS = 0.0001

local by_type = {}     -- [hit.<typ>] = nasobic
local registered = false

local HIT_ID = {}
for _, k in ipairs(rezone_presets.HIT_TYPES) do
	if hit[k] then HIT_ID[k] = hit[k] end
end

local function actor_on_before_hit(shit, bone_id, flags)
	if not (shit and shit.power > 0) then return end
	local m = by_type[shit.type]
	if m then shit.power = shit.power * m end
end

local function set_registered(on)
	if on == registered then return end
	registered = on
	if on then
		RegisterScriptCallback("actor_on_before_hit", actor_on_before_hit)
	else
		UnregisterScriptCallback("actor_on_before_hit", actor_on_before_hit)
	end
	core.log("poskozeni hrace: %s", on and "zapnuto" or "vse x1, vypnuto")
end

function load()
	local g = core.page(PAGE)
	by_type = {}
	local any = false
	for k, id in pairs(HIT_ID) do
		local m = tonumber(g(k)) or 1
		if math.abs(m - 1) > EPS then
			by_type[id] = m		-- v tabulce jen to, co se opravdu meni
			any = true
		end
	end
	set_registered(g("enabled") ~= false and any)
end

-- 2.5.40: predvolba Call of Pripyat mela mutanty x0.4 a udery x0.5 - s EFTH skoro nulove poskozeni.
-- Kdo ma ulozenou CoP predvolbu se starymi cisly, dostane jednou nove (vlastni upravy zustanou).
local function migrate_cop()
	local c = axr_main and axr_main.config
	if not c or c:r_value("rezone_internal", "pdmg_cop_v2", 1, false) then return end
	local pre = tonumber(c:r_value("mcm", PAGE .. "/preset", 2)) or 0
	if pre == 1 then
		local function fix(key, old, new)
			local v = tonumber(c:r_value("mcm", PAGE .. "/" .. key, 2))
			if v and math.abs(v - old) < 0.001 then
				c:w_value("mcm", PAGE .. "/" .. key, new)
				if ui_mcm and ui_mcm.set then pcall(ui_mcm.set, PAGE .. "/" .. key, new) end
			end
		end
		fix("wound", 0.4, 1.0)
		fix("strike", 0.5, 0.75)
	end
	c:w_value("rezone_internal", "pdmg_cop_v2", true)
	c:save()
end

function on_game_start()
	pcall(migrate_cop)
	core.on_change(load)
	load()
end
