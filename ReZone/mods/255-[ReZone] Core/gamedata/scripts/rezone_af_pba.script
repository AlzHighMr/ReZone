-- ======================================================================
-- ReZone Artefacts CoP - perks for the strongest artefact of each family
-- Uses Perk Based Artefacts (demonized). Without PBA nothing happens.
--
-- The top artefact of a family gets a PBA perk (shown in its tooltip).
-- SGM Selekce: "Tier T3" of any family member gets the family perk too,
-- and every upgrade of the top artefact keeps it.
-- Artefacts in AAC / AAM count when PBA allows containers (PBA MCM).
-- ======================================================================

-- family: members (weakest -> strongest), PBA perk of the strongest
FAMILIES = {
	{ perk = "af_atom",        members = { "af_medusa", "af_vyvert", "af_baloon" } },               -- odvod radiace: Arszi's Blessing
	{ perk = "af_peas",        members = { "af_night_star", "af_gravi", "af_gold_fish" } },         -- nosnost: Friend of the Night
	{ perk = "af_black_angel", members = { "af_empty", "af_full_empty" } },                         -- balistika: Dodge This
	{ perk = "af_signet",      members = { "af_cristall_flower", "af_lobster_eyes", "af_electra_moonlight", "af_black_spray" } }, -- psi: Light of Tranquility
	{ perk = "af_sun",         members = { "af_itcher", "af_pin", "af_cristall", "af_fireball" } }, -- teplo: Solar Powered
	{ perk = "af_kislushka",   members = { "af_dummy_glassbeads", "af_eye", "af_fire" } },          -- krvaceni: What Colour Is Your Blood?
	{ perk = "af_grapes",      members = { "af_blood", "af_mincer_meat", "af_bracelet" } },         -- chemie: Necessary Gluttony
	{ perk = "af_ear",         members = { "af_soul", "af_fuzz_kolobok", "af_glass" } },            -- zdravi: Will to Live
	{ perk = "af_elektron",    members = { "af_electra_sparkler", "af_sponge", "af_ring", "af_electra_flash" } }, -- elektro: Crank High Voltage
	{ perk = "af_generator",   members = { "af_dummy_battery", "af_dummy_dummy", "af_ice" } },      -- vydrz: Godzilla is Approaching
	{ perk = "af_fonar",       members = { "af_compass" } },                                        -- Enlightening Kleptomania
	{ perk = "af_signet",      members = { "af_oasis_heart" } },                                    -- Light of Tranquility
	{ perk = "af_cocoon",      members = { "af_monolith" } },                                       -- Stone Skin
}

local BREED_TYPES = { "rad", "cw", "reg", "tier" }

local function pba_present()
	local ok, fs = pcall(getFS)
	if (not ok) or (not fs) then return false end
	return fs:exist("$game_scripts$", "perk_based_artefacts.script") ~= nil
end

local done = false
function Inject()
	if (done) then return true end
	if (not pba_present()) then return false end
	local ok, props = pcall(function() return perk_based_artefacts.artefact_props end)
	if (not ok) or (type(props) ~= "table") then return false end
	local n = 0
	for _, f in ipairs(FAMILIES) do
		local p = props[f.perk]
		if (type(p) == "table") and (type(p.sections) == "table") then
			local top = f.members[#f.members]
			local function add(sec)
				if (ini_sys:section_exist(sec)) then p.sections[sec] = true n = n + 1 end
			end
			add(top)
			for _, t in ipairs(BREED_TYPES) do
				for lv = 1, 4 do add(top .. "_brd_" .. t .. lv) end	-- rad/cw/reg a T4 = aliasy pro stare savy
			end
			for _, m in ipairs(f.members) do add(m .. "_brd_tier3"); add(m .. "_brd_tier4") end
		else
			if rezone_core and rezone_core.DEBUG then printf("! ReZone Artefacts: PBA perk %s not found", f.perk) end
		end
	end
	done = true
	if rezone_core and rezone_core.DEBUG then printf("ReZone Artefacts: %s sections got PBA perks", n) end
	return true
end

-- perk of an artefact section (for UI / other scripts)
function GetPerk(sec)
	for _, f in ipairs(FAMILIES) do
		local top = f.members[#f.members]
		if (sec == top) or (string.find(sec, "^" .. top .. "_brd_")) then return f.perk end
		for _, m in ipairs(f.members) do
			if (sec == m .. "_brd_tier3") or (sec == m .. "_brd_tier4") then return f.perk end
		end
	end
end

function on_game_start()
	Inject()
	-- PBA may build its tables later: try again on the first update
	RegisterScriptCallback("actor_on_first_update", function()
		Inject()
		pcall(function() perk_based_artefacts.force_refresh_state() end)
	end)
end
