--[[
	ReZone MCM - sila utoku mutantu (Zdravi > Sila utoku mutantu)
	- nasobic poskozeni, ktere mutant da hraci, podle druhu (vanilla i ReSpawn Mutants)
	- nasobi se v actor_on_before_hit spolu s "Poskozeni hrace" (to je podle typu zasahu)
	- vypnuto nebo vse na 1 = handler se odregistruje
--]]

local core = rezone_core
local PAGE = rezone_mcm.ROOT .. "/" .. rezone_mcm.TAB_HP .. "/rz_mutdmg"
local EPS = 0.0001

local by_species = {}
local registered = false

local function actor_on_before_hit(shit, bone_id, flags)
	if not (shit and shit.power and shit.power > 0) then return end
	local who = shit.draftsman
	if not (who and IsMonster(who)) then return end
	local s = core.species_of(who)
	local m = s and by_species[s]
	if m then shit.power = shit.power * m end
end

local function set_registered(on)
	if on == registered then return end
	registered = on
	if on then
		RegisterScriptCallback("actor_on_before_hit", actor_on_before_hit)
	else
		UnregisterScriptCallback("actor_on_before_hit", actor_on_before_hit)
	end
	core.log("sila utoku mutantu: %s", on and "zapnuto" or "vypnuto")
end

function load()
	local g = core.page(PAGE)
	local all = tonumber(g("all")) or 1
	by_species = {}
	local any = false
	for _, s in ipairs(rezone_mcm.ALL_SPECIES) do
		local m = (tonumber(g(s)) or 1) * all
		if math.abs(m - 1) > EPS then by_species[s] = m; any = true end
	end
	set_registered(g("enabled") == true and any)
end

function on_game_start()
	core.on_change(load)
	load()
end
