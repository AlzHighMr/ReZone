; =====================================================================================
;  ReZone - vzacne artefakty leci casti tela (jen s EFT Health System)
;
;  EFT Health System bere zdravi z casti tela a vanilla regeneraci artefaktu zahodi.
;  Artefakty nize proto leci casti tela primo (nejvic poskozenou cast, nejdriv docasne HP).
;  Bez EFT Health System se nic nedeje - plati vanilla regenerace artefaktu.
;
;  Radek:  artefakt = HP za minutu, zastavi slabe krvaceni (0/1), probudi znicenou cast (0/1)
;    HP za minutu: telo ma 100 HP; plati na pasu, nasobi se stavem artefaktu a MCM (Zdravi > Artefakty)
;    krvaceni:     obcas zastavi slabe krvaceni na jedne casti tela
;    znicena cast: pomalu ji vyleci jako u ohne (podle MCM EFT Health System)
;  Vylepsene artefakty (selekce) dedi hodnotu zakladu; typ Stupen ji zvysi, typ Regenerace prida [reg].
; =====================================================================================
[settings]
tick        = 5         ; po kolika sekundach se leci
bleed_chance = 0.25     ; sance za tick, ze artefakt zastavi slabe krvaceni

[artefacts]
af_fuzz_kolobok   = 1.5, 0, 0
af_glass          = 3, 1, 0
af_oasis_heart    = 6, 1, 1
af_ameba_mica     = 1.5, 1, 0     ; SoC ameba - slida
af_dummy_pellicle = 1, 0, 0

; selekce: nasobic HP podle stupne pro typ "tier" (T1..T4)
[tier]
mult = 1.3, 1.6, 2.0, 2.5

; selekce typu Regenerace: HP za minutu navic podle stupne (T1..T4), i u artefaktu, ktere jinak neleci
[reg]
hp = 0.5, 1, 1.5, 2
