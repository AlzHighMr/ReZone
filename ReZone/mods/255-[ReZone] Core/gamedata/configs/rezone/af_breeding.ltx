; -------------------------------------------------------------------------------------
; Cena selekce = cena zakladniho artefaktu x nasobic stupne (zaokrouhleno na 100 RU), minimum min.
; Meduza (24 900): T1 12 500, T2 18 700, T3 24 900, T4 37 400
; -------------------------------------------------------------------------------------
[prices]
mult = 0.5, 0.75, 1.0, 1.5
min  = 5000

; -------------------------------------------------------------------------------------
; Bonus vylepseni = ladder[tier artefaktu] x nasobic stupne (T1, T2, T3, T4).
;   rad: radiace se SNIZI o nasobek zebricku (T1 = vlastni radiace zmizi, vys = odvadi)
;   cw : pridana nosnost     reg: pridane zdravi i vydrz
;   tier: vlastni efekty x nasobic, radiace x tier_rad; tier zvyseny jen u plusu, minus zustava
; -------------------------------------------------------------------------------------
[bonus]
rad      = 1.0, 1.5, 2.0, 2.5
cw       = 0.33, 0.66, 1.0, 1.33
reg      = 0.25, 0.5, 0.75, 1.0
tier     = 1.3, 1.6, 2.0, 2.5
tier_rad = 0.75, 0.5, 0.25, 0.1

; prodejni cena vylepseneho artefaktu = cena zakladu x nasobic stupne
[value]
mult = 1.25, 1.6, 2.0, 2.6

; -------------------------------------------------------------------------------------
