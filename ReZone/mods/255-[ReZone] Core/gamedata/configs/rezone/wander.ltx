l06_rostok           = rostok, true, 2
k02_trucks_cemetery  = trucks, true, 2
l08_yantar           = yantar, true, 2
l07_military         = military, true, 2
l09_deadcity         = deadcity, true, 2
l10_red_forest       = red_forest, false, 3
l10_limansk          = limansk, false, 3
l11_hospital         = hospital, false, 3
l10_radar            = radar, false, 3
zaton                = zaton, true, 3
jupiter              = jupiter, true, 3
pripyat              = pripyat, false, 3
l11_pripyat          = pripyat_soc, false, 3
l12_stancia          = stancia, false, 3
l12_stancia_2        = stancia_2, false, 3
l13_generators       = generators, false, 3

[factions]
stalker   = f_stalker, true, stalker, stalker
csky      = f_csky, true, csky, csky
dolg      = f_dolg, true, duty, dolg
freedom   = f_freedom, true, freedom, freedom
