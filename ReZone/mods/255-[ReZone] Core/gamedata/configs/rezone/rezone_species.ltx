; ReZone MCM - urceni druhu mutanta
; Druh se bere z klice "species" (pripadne "community") v sekci mutanta.
; Tady se jen prekladaji jine nazvy na druhy z MCM a pridavaji vyjimky.
; Rozsireni pres DLTX: configs\rezone\mod_rezone_species_<cokoliv>.ltx

; jiny nazev druhu -> druh v MCM
[aliases]
giant       = pseudo_gigant
gigant      = pseudo_gigant
pseudogiant = pseudo_gigant
psy_dog     = pseudodog
psydog      = pseudodog
tushkan     = tushkano

; konkretni sekce mutanta -> druh v MCM (kdyz species chybi nebo nesedi)
; priklad:  m_muj_novy_mutant = bloodsucker
[sections]

; ReSpawn Mutants (Hades@DK) - kazda rodina ma v MCM vlastni posuvnik (odolnost i sila utoku)
