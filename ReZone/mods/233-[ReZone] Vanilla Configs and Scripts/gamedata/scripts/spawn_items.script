local world_poss = {

	-- Kordon
	{
		"helm_respirator",
		338.6276550293,
		18.372943878174,
		238.10443115234,
		43603,
		364,
	},
}


local spawned_poss = {}
local spawned_world_poss = {}

local function round_pos(value)
	return round_idp(value, 1)
end

local function get_stash_id(p)
	return tostring(p[1]) .. "_" ..
	       tostring(p[2]) .. "_" ..
	       tostring(p[3]) .. "_" ..
	       tostring(p[4]) .. "_" ..
	       tostring(p[5])
end


local function spawn_stash_items()

	for i = 1, 65534 do

		local se_obj = alife_object(i)

		if se_obj and IsInvbox(se_obj) then

			local obj_pos = se_obj.position
			local obj_lvid = se_obj.m_level_vertex_id
			local obj_gvid = se_obj.m_game_vertex_id

			for j = 1, #poss do

				local p = poss[j]
				local stash_id = get_stash_id(p)

				if not spawned_poss[stash_id] then

					local pos_check =
						round_pos(obj_pos.x) == round_pos(p[1])
						and
						round_pos(obj_pos.y) == round_pos(p[2])
						and
						round_pos(obj_pos.z) == round_pos(p[3])

					local vertex_check =
						obj_lvid == p[4]
						and
						obj_gvid == p[5]

					if pos_check and vertex_check then

						for n = 1, #p[6] do
							alife_create_item(p[6][n], se_obj)
						end

						spawned_poss[stash_id] = true

					end

				end

			end

		end

	end

end

local function spawn_world_items()
	for i = 1, #world_poss do
		if not spawned_world_poss[i] then
			local w = world_poss[i]
			local sec = w[1]
			local pos = vector():set(w[2],w[3],w[4])
			local lvid = w[5]
			local gvid = w[6]

			if sec and pos and lvid and gvid then

				alife_create_item(sec,{pos,lvid,gvid})
				spawned_world_poss[i] = true

			end
		end
	end
end


function delay_items_spawn()
	spawn_stash_items()
	spawn_world_items()
	return true
end

function actor_on_first_update()
	CreateTimeEvent("some_itms_spawn_e","some_itms_spawn_a",2,delay_items_spawn)
end

function save_state(m_data)
	m_data.spawned_poss = spawned_poss
	m_data.spawned_world_poss = spawned_world_poss
end

function load_state(m_data)
	spawned_poss = m_data.spawned_poss or {}
	spawned_world_poss = m_data.spawned_world_poss or {}
end

function on_game_start()
	RegisterScriptCallback("actor_on_first_update",actor_on_first_update)
	RegisterScriptCallback("save_state",save_state)
	RegisterScriptCallback("load_state",load_state)
end